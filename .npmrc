# GitHub Packages hosts both the @cpdevtools release toolchain and this
# workspace's own @myrddraall packages.
@myrddraall:registry=https://npm.pkg.github.com
@cpdevtools:registry=https://npm.pkg.github.com

# Authentication is deliberately NOT configured here.
#
# pnpm 10+ refuses to expand environment variables in registry credentials that
# come from a project .npmrc, because that file is committed and a malicious
# registry entry could otherwise exfiltrate the token. A line such as
#
#   //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
#
# is silently ignored with a warning, so leaving one here would only look like
# it worked. Put the credential somewhere pnpm still trusts instead:
#
#   pnpm config set "//npm.pkg.github.com/:_authToken" "$GITHUB_TOKEN"
#
# This devcontainer already does that in its postCreate step. In CI, the
# git-flow actions authenticate from the job's GITHUB_TOKEN.
