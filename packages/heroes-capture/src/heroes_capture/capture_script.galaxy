//--------------------------------------------------------------------------------------------------
// Map capture (injected by heroes-capture)
// "tile <n> <x> <y>" (typed into the command box) moves the camera to tile n; the status strip
// reports when it is done.
//--------------------------------------------------------------------------------------------------
const bool hrsCap_hideStructures = ${hide_structures};
const fixed hrsCap_distance = ${distance};
const fixed hrsCap_pitch = ${pitch};
const int hrsCap_tileCount = ${tile_count};
int hrsCap_currentTile = 0;
fixed hrsCap_curX = 0.0;  // the current tile's camera target (from the command, else the table)
fixed hrsCap_curY = 0.0;
fixed[${tile_count}] hrsCap_tileX;
fixed[${tile_count}] hrsCap_tileY;
trigger hrsCap_gt_Tile;
trigger hrsCap_gt_Clean;
trigger hrsCap_gt_Black;
trigger hrsCap_gt_Sky;
trigger hrsCap_gt_Pause;
trigger hrsCap_gt_Move;
trigger hrsCap_gt_Look;
trigger hrsCap_gt_Clip;
trigger hrsCap_gt_Fov;
trigger hrsCap_gt_Note;
trigger hrsCap_gt_BgSpeed;
trigger hrsCap_gt_Unbound;
trigger hrsCap_gt_RefitWait;
trigger hrsCap_gt_HideMap;
trigger hrsCap_gt_Quiet;
trigger hrsCap_gt_Element;
bool hrsCap_keepCreeps = false;  // command "el keep 1": the sweep leaves camps and objectives alone (the elements probe)
fixed hrsCap_refitWait = 0.1;  // real seconds the lighting-refit look is held before each tile (command "refitwait"; 0.25 until the waits probe showed shorter changes nothing but the effects that animate anyway)
bool hrsCap_unbound = false;  // command "unbound": the camera may go anywhere on the map (tiles past the camera bounds)
trigger hrsCap_gt_Quit;
trigger hrsCap_gt_Sweep;
trigger hrsCap_gt_FastForward;

// The map's state.
int hrsCap_skyState = 0;  // 1 the matte's light sky (sky.py LIGHT_SKY), 2 black, 0 other
fixed hrsCap_bgSpeed = 100.0;  // animation speed (percent) "sky" gives a background; command "bgspeed"
const string hrsCap_mapSky = "${map_sky}";  // the map's own sky models (probes)
const string hrsCap_mapParallax = "${map_parallax}";
bool hrsCap_paused = false;  // the map's animations have been paused (once the game started)
bool hrsCap_eventOff = false;  // the map's event switched off (MapMechanicsLib), before the gates open
bool[64] hrsCap_frameShown;  // which interface frame types the match showed at its start (hrsCap_SaveFrames), by type less c_syncFrameTypeFirst
bool hrsCap_forwardStarted = false;  // the fast-forward after the gates opened has begun
bool hrsCap_ready = false;  // fast-forward done: the map's opening events have happened
bool hrsCap_leaving = false;  // "quit" received: the match is ending
int hrsCap_clearedSinceReady = 0;  // units the clearing removed after the map was ready
bool hrsCap_introOn = false;  // the map's intro cutscene is playing (set by the sweep)
int hrsCap_openingCuts = 0;  // opening timers cut short so far
unit[128] hrsCap_copies;  // the elements' copies of structures ("el copy"), by number
const fixed hrsCap_gatesDelay = 3.0;  // seconds to the gates opening (the game's default is 35)
const fixed hrsCap_forwardSeconds = ${forward_seconds};  // real seconds the map's opening timers are kept short (none known for this map: no wait)
const fixed hrsCap_readySeconds = 18.0;  // real seconds from the gates opening to the map ready and paused, fast-forward included: the cores' entrance animation hadn't finished at 10

//--------------------------------------------------------------------------------------------------
// The status strip: a dialog in the top-left corner, two columns of ${status_rows} black-or-white cells
// (wide and short), redrawn at the end of every command and every sweep. The capture reads
// it from the screen far faster than it can judge the picture, so it knows when a command has
// been carried out and rendered. Cells: 0 white, 1 black (locator), then bits: command sequence
// number (8), game clock since the gates opened in seconds (10), camera target x and y in 1/64
// cells (15 each), unused (1), sky white, sky black, tick (flips every sweep), ready (the gates
// have opened and the map's opening events are in place), the map's identity (16 bits, a hash of
// its prepared id: the capture checks it is driving the map it prepared), the map's phase (2
// bits: 0 before the gates open, 1 the opening timers being cut short, 2 ready, 3 leaving),
// units cleared since ready (8: something spawning mid-render), intro cutscene playing (1),
// opening timers cut short so far (4), parity of all bits, and a black end cell.
//--------------------------------------------------------------------------------------------------
const int hrsCap_statusCells = ${status_cells};
const int hrsCap_statusCellW = ${status_cell_w};  // cell size in interface units
const int hrsCap_statusCellH = ${status_cell_h};
const int hrsCap_statusRows = ${status_rows};
const int hrsCap_mapId = ${map_id};  // the prepared map's identity (inject.py)
int hrsCap_status = c_invalidDialogId;
int[${status_cells}] hrsCap_statusCtl;
int hrsCap_statusBackdrop = c_invalidDialogControlId;
int hrsCap_statusBackdropDialog = c_invalidDialogId;
int hrsCap_statusFiller = c_invalidDialogControlId;
int hrsCap_seq = 0;
int hrsCap_tick = 0;
int hrsCap_statusParity = 0;
int hrsCap_statusPlayer = 1;

int hrsCap_LocalPlayer () {
    int lv_p;

    lv_p = 1;
    for ( ; lv_p <= 10 ; lv_p += 1 ) {
        if ((PlayerStatus(lv_p) == c_playerStatusActive)) {
            return lv_p;
        }
    }
    return 1;
}

// Cell lp_cell of the strip's 88 (logical): the second column starts with a fixed black cell
// (so the locator's white cell can't run into a white cell beside it), so cells from the
// column's height on sit one further down.
void hrsCap_StatusCell (int lp_cell, int lp_bit) {
    int lv_c;

    lv_c = lp_cell;
    if ((lv_c >= hrsCap_statusRows)) {
        lv_c += 1;
    }
    if ((lp_bit != 0)) {
        DialogControlSetPropertyAsColor(hrsCap_statusCtl[lv_c], c_triggerControlPropertyColor, PlayerGroupAll(), Color(100.0, 100.0, 100.0));
    }
    else {
        DialogControlSetPropertyAsColor(hrsCap_statusCtl[lv_c], c_triggerControlPropertyColor, PlayerGroupAll(), Color(0.0, 0.0, 0.0));
    }
}

// Bits of a value, least significant first, into cells from lp_start; the parity keeps up.
void hrsCap_StatusBits (int lp_start, int lp_count, int lp_value) {
    int lv_i;
    int lv_bit;

    lv_i = 0;
    for ( ; lv_i < lp_count ; lv_i += 1 ) {
        lv_bit = ((lp_value >> lv_i) & 1);
        hrsCap_statusParity = (hrsCap_statusParity ^ lv_bit);
        hrsCap_StatusCell((lp_start + lv_i), lv_bit);
    }
}

void hrsCap_StatusDraw () {
    point lv_target;
    int lv_x;
    int lv_y;

    if ((hrsCap_status == c_invalidDialogId)) {
        return;
    }
    lv_target = CameraGetTarget(hrsCap_statusPlayer);
    lv_x = FixedToInt((PointGetX(lv_target) * 64.0) + 0.5);
    lv_y = FixedToInt((PointGetY(lv_target) * 64.0) + 0.5);
    if ((lv_x < 0)) { lv_x = 0; }
    if ((lv_y < 0)) { lv_y = 0; }
    if ((lv_x > 32767)) { lv_x = 32767; }
    if ((lv_y > 32767)) { lv_y = 32767; }
    hrsCap_statusParity = 0;
    hrsCap_StatusCell(0, 1);
    hrsCap_StatusCell(1, 0);
    hrsCap_StatusBits(2, 8, hrsCap_seq);
    hrsCap_StatusBits(10, 10, MinI(1023, FixedToInt(TimerGetElapsed(libGame_gv_gameTimer))));  // game clock since the gates, seconds
    hrsCap_StatusBits(20, 15, lv_x);
    hrsCap_StatusBits(35, 15, lv_y);
    hrsCap_StatusBits(50, 1, 0);  // unused
    hrsCap_StatusBits(51, 1, BoolToInt((hrsCap_skyState == 1)));
    hrsCap_StatusBits(52, 1, BoolToInt((hrsCap_skyState == 2)));
    hrsCap_StatusBits(53, 1, hrsCap_tick);
    hrsCap_StatusBits(54, 1, BoolToInt(hrsCap_ready));
    hrsCap_StatusBits(55, 16, hrsCap_mapId);
    hrsCap_StatusBits(73, 8, MinI(255, hrsCap_clearedSinceReady));
    hrsCap_StatusBits(81, 1, BoolToInt(hrsCap_introOn));
    hrsCap_StatusBits(82, 4, MinI(15, hrsCap_openingCuts));
    if (hrsCap_leaving) {
        hrsCap_StatusBits(71, 2, 3);
    }
    else if (hrsCap_ready) {
        hrsCap_StatusBits(71, 2, 2);
    }
    else if (hrsCap_forwardStarted) {
        hrsCap_StatusBits(71, 2, 1);
    }
    else {
        hrsCap_StatusBits(71, 2, 0);
    }
    hrsCap_StatusCell(86, hrsCap_statusParity);
    hrsCap_StatusCell(87, 0);
    DialogControlSetPropertyAsColor(hrsCap_statusCtl[hrsCap_statusRows], c_triggerControlPropertyColor, PlayerGroupAll(), Color(0.0, 0.0, 0.0));
}

// The command being carried out and who sent it (hrsCap_RunCommand sets them): the commands read
// their words from it, as they once read the chat message.
string hrsCap_cmd = "";
int hrsCap_cmdPlayer = 1;

// The sequence number a command carries as its last word (the capture appends it).
int hrsCap_CommandSeq () {
    string lv_s;
    string lv_word;
    string lv_last;
    int lv_n;

    lv_s = hrsCap_cmd;
    lv_last = "";
    lv_n = 1;
    // As far as hrsCap_CommandWords reads: a longer command ("el copy <n> make <x> <y> <to x>
    // <to y>" is 8 words before its number) was carried out but answered with one of its own words.
    for ( ; lv_n <= 17 ; lv_n += 1 ) {
        lv_word = StringWord(lv_s, lv_n);
        if ((lv_word == "")) {
            break;
        }
        lv_last = lv_word;
    }
    return (StringToInt(lv_last) & 255);
}

// Called at the end of a command, once its work is done: the strip shows its sequence number.
void hrsCap_Ack () {
    hrsCap_statusPlayer = hrsCap_cmdPlayer;
    hrsCap_seq = hrsCap_CommandSeq();
    hrsCap_StatusDraw();
}

void hrsCap_StatusInit () {
    int lv_k;

    // A black backdrop down the left edge below the cells: its own dialog, anchored to the
    // bottom-left and reaching up behind the cells; created first, the strip draws over it.
    hrsCap_statusBackdropDialog = DialogCreate((hrsCap_statusCellW * 2), 700, c_anchorBottomLeft, 0, 0, false);
    DialogSetImageVisible(hrsCap_statusBackdropDialog, false);
    hrsCap_statusBackdrop = DialogControlCreate(hrsCap_statusBackdropDialog, c_triggerControlTypeImage);
    DialogControlSetPropertyAsString(hrsCap_statusBackdrop, c_triggerControlPropertyImage, PlayerGroupAll(), "Assets/Textures/HrsWhite.dds");
    DialogControlSetPropertyAsInt(hrsCap_statusBackdrop, c_triggerControlPropertyImageType, PlayerGroupAll(), c_triggerImageTypeNormal);
    DialogControlSetPropertyAsColor(hrsCap_statusBackdrop, c_triggerControlPropertyColor, PlayerGroupAll(), Color(0.0, 0.0, 0.0));
    DialogControlSetSize(hrsCap_statusBackdrop, PlayerGroupAll(), (hrsCap_statusCellW * 2), 700);
    DialogControlSetPosition(hrsCap_statusBackdrop, PlayerGroupAll(), c_anchorTopLeft, 0, 0);
    DialogSetVisible(hrsCap_statusBackdropDialog, PlayerGroupAll(), true);
    hrsCap_status = DialogCreate((hrsCap_statusCellW * 2), (hrsCap_statusCellH * hrsCap_statusRows), c_anchorTopLeft, 0, 0, false);
    DialogSetImageVisible(hrsCap_status, false);
    // Black under the second column's cells, down to the strip's foot (the backdrop dialog
    // takes over from there).
    hrsCap_statusFiller = DialogControlCreate(hrsCap_status, c_triggerControlTypeImage);
    DialogControlSetPropertyAsString(hrsCap_statusFiller, c_triggerControlPropertyImage, PlayerGroupAll(), "Assets/Textures/HrsWhite.dds");
    DialogControlSetPropertyAsInt(hrsCap_statusFiller, c_triggerControlPropertyImageType, PlayerGroupAll(), c_triggerImageTypeNormal);
    DialogControlSetPropertyAsColor(hrsCap_statusFiller, c_triggerControlPropertyColor, PlayerGroupAll(), Color(0.0, 0.0, 0.0));
    DialogControlSetSize(hrsCap_statusFiller, PlayerGroupAll(), hrsCap_statusCellW, (hrsCap_statusCellH * ((2 * hrsCap_statusRows) - hrsCap_statusCells)));
    DialogControlSetPosition(hrsCap_statusFiller, PlayerGroupAll(), c_anchorTopLeft, hrsCap_statusCellW, (hrsCap_statusCellH * (hrsCap_statusCells - hrsCap_statusRows)));
    lv_k = 0;
    for ( ; lv_k < hrsCap_statusCells ; lv_k += 1 ) {
        hrsCap_statusCtl[lv_k] = DialogControlCreate(hrsCap_status, c_triggerControlTypeImage);
        DialogControlSetPropertyAsString(hrsCap_statusCtl[lv_k], c_triggerControlPropertyImage, PlayerGroupAll(), "Assets/Textures/HrsWhite.dds");
        DialogControlSetPropertyAsInt(hrsCap_statusCtl[lv_k], c_triggerControlPropertyImageType, PlayerGroupAll(), c_triggerImageTypeNormal);
        DialogControlSetSize(hrsCap_statusCtl[lv_k], PlayerGroupAll(), hrsCap_statusCellW, hrsCap_statusCellH);
        DialogControlSetPosition(hrsCap_statusCtl[lv_k], PlayerGroupAll(), c_anchorTopLeft, ((lv_k / hrsCap_statusRows) * hrsCap_statusCellW), (ModI(lv_k, hrsCap_statusRows) * hrsCap_statusCellH));
    }
    hrsCap_statusPlayer = hrsCap_LocalPlayer();
    hrsCap_StatusDraw();
    DialogSetVisible(hrsCap_status, PlayerGroupAll(), true);
}

//--------------------------------------------------------------------------------------------------
// The note: a line of text at the top middle of the screen saying what the capture is waiting on
// while nothing is being shot (the rubble prepared, a wave falling), so the plain sky the screen
// shows meanwhile isn't a mystery. "note <text>" shows it, "note" alone hides it; "tile" and
// "el at", which every shot starts with, hide it first (hrsCap_RunCommand), so no shot has it.
//--------------------------------------------------------------------------------------------------
int hrsCap_noteDialog = c_invalidDialogId;
int hrsCap_noteLabel = c_invalidDialogControlId;

void hrsCap_NoteInit () {
    int lv_backdrop;

    hrsCap_noteDialog = DialogCreate(1000, 50, c_anchorTop, 0, 30, false);
    DialogSetImageVisible(hrsCap_noteDialog, false);
    lv_backdrop = DialogControlCreate(hrsCap_noteDialog, c_triggerControlTypeImage);
    DialogControlSetPropertyAsString(lv_backdrop, c_triggerControlPropertyImage, PlayerGroupAll(), "Assets/Textures/HrsWhite.dds");
    DialogControlSetPropertyAsInt(lv_backdrop, c_triggerControlPropertyImageType, PlayerGroupAll(), c_triggerImageTypeNormal);
    DialogControlSetPropertyAsColor(lv_backdrop, c_triggerControlPropertyColor, PlayerGroupAll(), Color(0.0, 0.0, 0.0));
    DialogControlSetSize(lv_backdrop, PlayerGroupAll(), 1000, 50);
    DialogControlSetPosition(lv_backdrop, PlayerGroupAll(), c_anchorTopLeft, 0, 0);
    hrsCap_noteLabel = DialogControlCreate(hrsCap_noteDialog, c_triggerControlTypeLabel);
    DialogControlSetFullDialog(hrsCap_noteLabel, PlayerGroupAll(), true);
    DialogControlSetPosition(hrsCap_noteLabel, PlayerGroupAll(), c_anchorCenter, 0, 0);
    DialogControlSetPropertyAsString(hrsCap_noteLabel, c_triggerControlPropertyStyle, PlayerGroupAll(), "ScreenButtonText");
}

void hrsCap_NoteShow (string lp_text) {
    DialogControlSetPropertyAsText(hrsCap_noteLabel, c_triggerControlPropertyText, PlayerGroupAll(), StringToText(lp_text));
    DialogSetVisible(hrsCap_noteDialog, PlayerGroupAll(), true);
}

void hrsCap_NoteHide () {
    DialogSetVisible(hrsCap_noteDialog, PlayerGroupAll(), false);
}

//--------------------------------------------------------------------------------------------------
// The command box: the capture types each command into an edit box of the map's own, in the
// strip's column (blanked from every shot), as Unicode text ending in ";": "tile 3 12.5 30.25 17;".
// Text input never acts as a hotkey wherever it lands, and unlike the chat box, which opens and
// closes on Enter and loses its state when the game loses focus, the box has none to lose (the
// input probe measured it: about 90 ms from typing to the strip's answer, against about 230 ms
// through chat, and it kept the keyboard after an alt-tab). Read when its text changes (dialog
// event type 5, a number: its name isn't in Blizzard's code) and by the sweep as a backstop; the
// last complete command in it is carried out (earlier ones the capture has given up on), and the
// box emptied. Until the first command arrives the sweep keeps asking for the keyboard for it
// (the match is starting); after that, never (the player's own menus keep theirs). The chat
// command "focus <seq> ;" gives it the keyboard back if it ever lost it (the capture sends it
// when a command goes unanswered; if the box had the keyboard after all, the text lands in it and
// is a command too).
//--------------------------------------------------------------------------------------------------
int hrsCap_boxDialog = c_invalidDialogId;
int hrsCap_box = c_invalidDialogControlId;
bool hrsCap_boxUsed = false;  // a command has come through the box
trigger hrsCap_gt_BoxChanged;
trigger hrsCap_gt_Focus;

// A command: its first word picks the trigger, run as a thread of its own (a tile waits for the
// camera), with the command and the sender set for it.
void hrsCap_RunCommand (string lp_text, int lp_player) {
    string lv_word;
    trigger lv_t;

    hrsCap_cmd = lp_text;
    hrsCap_cmdPlayer = lp_player;
    lv_word = StringWord(lp_text, 1);
    lv_t = null;
    // A shot starts with "tile" or "el at": the note comes down first, so no shot has it.
    if ((lv_word == "tile") || ((lv_word == "el") && (StringWord(lp_text, 2) == "at"))) {
        hrsCap_NoteHide();
    }
    if ((lv_word == "tile")) { lv_t = hrsCap_gt_Tile; }
    else if ((lv_word == "clean")) { lv_t = hrsCap_gt_Clean; }
    else if ((lv_word == "black")) { lv_t = hrsCap_gt_Black; }
    else if ((lv_word == "sky")) { lv_t = hrsCap_gt_Sky; }
    else if ((lv_word == "move")) { lv_t = hrsCap_gt_Move; }
    else if ((lv_word == "look")) { lv_t = hrsCap_gt_Look; }
    else if ((lv_word == "clip")) { lv_t = hrsCap_gt_Clip; }
    else if ((lv_word == "fov")) { lv_t = hrsCap_gt_Fov; }
    else if ((lv_word == "hidemap")) { lv_t = hrsCap_gt_HideMap; }
    else if ((lv_word == "pause")) { lv_t = hrsCap_gt_Pause; }
    else if ((lv_word == "refitwait")) { lv_t = hrsCap_gt_RefitWait; }
    else if ((lv_word == "unbound")) { lv_t = hrsCap_gt_Unbound; }
    else if ((lv_word == "bgspeed")) { lv_t = hrsCap_gt_BgSpeed; }
    else if ((lv_word == "quit")) { lv_t = hrsCap_gt_Quit; }
    else if ((lv_word == "el")) { lv_t = hrsCap_gt_Element; }
    else if ((lv_word == "note")) { lv_t = hrsCap_gt_Note; }
    if ((lv_t != null)) {
        TriggerExecute(lv_t, false, false);
    }
    else {
        hrsCap_Ack();  // "focus", or a word the map doesn't know: answered all the same
    }
}

// The box read: its last complete command carried out, the box emptied.
void hrsCap_ReadBox () {
    string lv_s;
    string lv_last;
    int lv_end;

    if ((hrsCap_box == c_invalidDialogControlId)) {
        return;
    }
    lv_s = DialogControlGetPropertyAsString(hrsCap_box, c_triggerControlPropertyEditText, hrsCap_LocalPlayer());
    lv_end = StringFind(lv_s, ";", c_stringCase);
    if ((lv_end <= 0)) {
        return;
    }
    lv_last = "";
    while ((lv_end > 0)) {
        lv_last = StringSub(lv_s, 1, (lv_end - 1));
        lv_s = StringSub(lv_s, (lv_end + 1), StringLength(lv_s));
        lv_end = StringFind(lv_s, ";", c_stringCase);
    }
    DialogControlSetPropertyAsString(hrsCap_box, c_triggerControlPropertyEditText, PlayerGroupAll(), "");
    hrsCap_boxUsed = true;
    hrsCap_RunCommand(lv_last, hrsCap_LocalPlayer());
}

bool hrsCap_gt_BoxChanged_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if ((EventDialogControl() == hrsCap_box)) {
        hrsCap_ReadBox();
    }
    return true;
}

// Chat "focus <seq> ;": the keyboard back to the box, answered.
bool hrsCap_gt_Focus_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    hrsCap_cmd = StringReplaceWord(EventChatMessage(false), ";", "", c_stringReplaceAll, c_stringCase);
    hrsCap_cmdPlayer = EventPlayer();
    DialogControlRequestFocus(hrsCap_box, PlayerGroupAll());
    hrsCap_Ack();
    return true;
}

void hrsCap_BoxInit () {
    hrsCap_boxDialog = DialogCreate((hrsCap_statusCellW * 2), 30, c_anchorBottomLeft, 0, 40, false);
    hrsCap_box = DialogControlCreate(hrsCap_boxDialog, c_triggerControlTypeEditBox);
    DialogControlSetSize(hrsCap_box, PlayerGroupAll(), (hrsCap_statusCellW * 2), 30);
    DialogControlSetPosition(hrsCap_box, PlayerGroupAll(), c_anchorTopLeft, 0, 0);
    DialogSetVisible(hrsCap_boxDialog, PlayerGroupAll(), true);
    hrsCap_gt_BoxChanged = TriggerCreate("hrsCap_gt_BoxChanged_Func");
    TriggerAddEventDialogControl(hrsCap_gt_BoxChanged, c_playerAny, hrsCap_box, 5);  // text changed (the input probe saw it fire as type 5)
    hrsCap_gt_Focus = TriggerCreate("hrsCap_gt_Focus_Func");
    TriggerAddEventChatMessage(hrsCap_gt_Focus, c_playerAny, "focus", false);
    DialogControlRequestFocus(hrsCap_box, PlayerGroupAll());
}

//--------------------------------------------------------------------------------------------------
// The scene: units, camera, interface, sky.
//--------------------------------------------------------------------------------------------------
void hrsCap_InitTiles () {
${tile_lines}
}

void hrsCap_RemoveUnits (unitfilter lp_filter) {
    unitgroup lv_g;
    int lv_u;
    unit lv_unit;

    lv_g = UnitGroup(null, c_playerAny, RegionEntireMap(), lp_filter, 0);
    lv_u = UnitGroupCount(lv_g, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_g, lv_u);
        if (lv_unit == null) { break; }
        // Objective units stay: Hanamura's payload carries the path lines drawn to it.
        if ((UnitGetType(lv_unit) == "Payload_Neutral") || (UnitGetType(lv_unit) == "Payload_Neutral_Warning")) { continue; }
        UnitRemove(lv_unit);
        if (hrsCap_ready) {
            hrsCap_clearedSinceReady += 1;
        }
    }
}

// Remove heroes, minions, mercenaries, map creatures and summons; what stays (structures, and
// map-mechanic units such as altars: removing those leaves holes in the terrain) loses its
// health bars, and is hidden in terrain-only mode. Hidden, not removed: removing a core could
// end the game.
void hrsCap_ClearUnits () {
    unitgroup lv_g;
    int lv_u;
    unit lv_unit;

    hrsCap_RemoveUnits(UnitFilter((1 << c_targetFilterHeroic), 0, (1 << c_targetFilterStructure), 0));
    hrsCap_RemoveUnits(UnitFilter((1 << c_targetFilterMinion), 0, (1 << c_targetFilterStructure), 0));
    if (!hrsCap_keepCreeps) {
        hrsCap_RemoveUnits(UnitFilter((1 << c_targetFilterCreep), 0, (1 << c_targetFilterStructure), 0));
        hrsCap_RemoveUnits(UnitFilter(0, (1 << (c_targetFilterMapCreature - 32)), (1 << c_targetFilterStructure), 0));
        hrsCap_RemoveUnits(UnitFilter(0, (1 << (c_targetFilterSummoned - 32)), (1 << c_targetFilterStructure), 0));
    }

    lv_g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), 0), 0);
    lv_u = UnitGroupCount(lv_g, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_g, lv_u);
        if (lv_unit == null) { break; }
        UnitSetState(lv_unit, c_unitStateStatusBar, false);
        // Never outlined under the mouse: a cursor left over a structure lit it up in its shot.
        UnitSetState(lv_unit, c_unitStateHighlightable, false);
        if (hrsCap_hideStructures) {
            ActorSend(libNtve_gf_MainActorofUnit(lv_unit), "SetVisibility");
        }
    }
}

// The camera bounds lifted to the whole map, after the command "unbound" (the capture's tiles past the
// camera bounds, where map content runs on past the edge of the grid). Before every pan: the map
// may put its own bounds back at any time.
void hrsCap_LiftBounds () {
    if (hrsCap_unbound) {
        CameraSetBounds(PlayerGroupAll(), RegionRect(0.0, 0.0, ${map_width}, ${map_height}), false);
    }
}

void hrsCap_ApplyCamera (int lp_player) {
    CameraLockInput(lp_player, true);
    CameraUseHeightDisplacement(lp_player, false);
    CameraSetValue(lp_player, c_cameraValuePitch, hrsCap_pitch, 0.0, -1, 10.0);
    CameraSetValue(lp_player, c_cameraValueYaw, 90.0, 0.0, -1, 10.0);
    CameraSetValue(lp_player, c_cameraValueDistance, hrsCap_distance, 0.0, -1, 10.0);${lens_lines}
}

// A camera like real play (distance 34, fov 45), shallow (pitch 35) and facing the map's main
// light (yaw ${refit_yaw}). The game fits its lighting (the region the main light and
// shadows are computed for) to the last camera it takes as normal and never refits it for the
// capture camera: the rest of the map was drawn without the main light (a dark, straight-edged
// area, a different one each match; dark boxes around holes). So every tile shows this camera
// at its centre for a few frames first, and the game refits around the tile. Only the latest
// look counts, and only a shallow look towards the light cleared every box (pitch 52 or other
// yaws left boxes around some holes).
void hrsCap_NormalCamera (int lp_player) {
    CameraSetValue(lp_player, c_cameraValuePitch, 35.0, 0.0, -1, 10.0);
    CameraSetValue(lp_player, c_cameraValueYaw, ${refit_yaw}, 0.0, -1, 10.0);
    CameraSetValue(lp_player, c_cameraValueDistance, 34.0, 0.0, -1, 10.0);
    CameraSetValue(lp_player, c_cameraValueFieldOfView, 45.0, 0.0, -1, 10.0);
}

// No fog of war, no unexplored black, no HUD, no messages, a top-down camera, the sky.
void hrsCap_Scene () {
    int lv_p;
    int lv_f;

    // (Not VisEnable(c_visTypeFog, false): with fog of war off the reveal below stops working,
    // and only the vision around one team's buildings is drawn lit.)
    // The whole map, not RegionEntireMap() (the playable area): terrain outside the playable
    // bounds is otherwise left unexplored, under the black fog-of-war mask and its gradient
    // at the boundary, which darkened the outer walls and trees of Dragon Shire to half.
    lv_p = 0;
    for ( ; lv_p <= 15 ; lv_p += 1 ) {
        VisExploreArea(lv_p, ${map_region}, true, false);
        VisRevealArea(lv_p, ${map_region}, 0.0, false);
    }

    lv_p = 1;
    for ( ; lv_p <= 10 ; lv_p += 1 ) {
        if ((PlayerStatus(lv_p) == c_playerStatusActive)) {
${hero_ui_lines}            hrsCap_ApplyCamera(lv_p);
        }
    }
${ui_lines}${bounds_line}
    hrsCap_LiftBounds();
    GameSetBackground(0, "${sky_model}", 100.0);  // the camera-fixed skybox (sky.py)
    hrsCap_skyState = ${sky_state};${doodad_lines}
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    // Every animation on the map paused (glows, fires, smoke, swaying trees, flags), the way
    // Blizzard's maps do at game over: the two shots of a tile then differ only by the sky.
    // Only once the map is ready (see hrsCap_gt_FastForward): everything the start and the
    // first objective bring is there; the sweep sends it the moment that is so.
    // (Water is the terrain's own layer, not an actor; its waves are time-driven in the shader
    // and neither its data nor catalog edits still them, so it keeps moving.)
    if (hrsCap_ready) {
        libNtve_gf_SendActorMessageToGameRegion(${map_region}, "AnimSetPausedAll");
    }
}

// The map's intro cutscene is still running for someone (the sweep stops it, and the game's
// intro code then takes a moment to restore the camera and interface).
bool hrsCap_IntroPlaying () {
    int lv_p;

    lv_p = 1;
    for ( ; lv_p <= 10 ; lv_p += 1 ) {
        if ((libMapM_gv_mMIntroCutscene[lv_p] != c_cutsceneNone) && (libMapM_gv_mMIntroCutsceneFinished[lv_p] == false)) {
            return true;
        }
    }
    return false;
}

// Skip the map's intro cutscene the way the game's own skip does: stop the cutscene. The
// intro (libMapM_gf_PlayMapMechanicIntroForPlayer) waits for its cutscene to end and then
// restores the camera, interface, sound and vision itself, so nothing is left half-done.
void hrsCap_SkipIntro () {
    int lv_p;

    lv_p = 1;
    for ( ; lv_p <= 10 ; lv_p += 1 ) {
        if ((libMapM_gv_mMIntroCutscene[lv_p] != c_cutsceneNone) && (libMapM_gv_mMIntroCutsceneFinished[lv_p] == false)) {
            CutsceneStop(libMapM_gv_mMIntroCutscene[lv_p]);
        }
    }
}

// The game's own in-world labels (mercenary camp names and timers) are text tags stored per
// camp in the map-mechanics library; hide them, or they end up in the screenshots.
void hrsCap_HideLabels () {
    int lv_c;

    lv_c = 1;
    for ( ; lv_c <= libMapM_gv_jungleMaxCamps ; lv_c += 1 ) {
        if ((libMapM_gv_jungleCreepCamps[lv_c].lv_campHelperTextTagOrder != c_textTagNone)) {
            TextTagShow(libMapM_gv_jungleCreepCamps[lv_c].lv_campHelperTextTagOrder, PlayerGroupAll(), false);
        }
        if ((libMapM_gv_jungleCreepCamps[lv_c].lv_campHelperTextTagChaos != c_textTagNone)) {
            TextTagShow(libMapM_gv_jungleCreepCamps[lv_c].lv_campHelperTextTagChaos, PlayerGroupAll(), false);
        }
        // The camp's name, description and respawn timer ("Bruiser Camp", "Defeat or bribe this
        // camp", "0:29") are an interface panel per camp, created inside the game's
        // MercCampPanel and positioned over the camp (the camp's own dialog is only the anchor).
        if ((libMapM_gv_uIJungleCampPanel.lv_jungleCreepCampsInfoPanel[lv_c] != c_invalidDialogControlId)) {
            DialogControlSetVisible(libMapM_gv_uIJungleCampPanel.lv_jungleCreepCampsInfoPanel[lv_c], PlayerGroupAll(), false);
        }
    }
    if ((libMapM_gv_uIJungleCampPanel.lv_jungleCreepCampsParentPanel != c_invalidDialogControlId)) {
        DialogControlSetVisible(libMapM_gv_uIJungleCampPanel.lv_jungleCreepCampsParentPanel, PlayerGroupAll(), false);
    }
}

// Put back what the capture changed: the game's end-of-match sequence (the camera flying to a
// core, the explosion) crashed the game the moment it started, with the interface hidden and
// the camera far out of its normal range. Blizzard's own cinematic exit restores the same
// things. The sky slots too, as a render leaves them (our sky in the fixed slot, the map's own
// parallax in the other, normal speed): leaving with them as the sky probes set them (a slot
// empty, keyed copies, speed 1) crashed the game the moment the match ended.
void hrsCap_Restore () {
    int lv_p;
    int lv_f;
    camerainfo lv_cam;

    TriggerEnable(hrsCap_gt_Sweep, false);
    hrsCap_bgSpeed = 100.0;
    GameSetBackground(0, "${sky_model}", 100.0);
    hrsCap_skyState = ${sky_state};
    if ((hrsCap_mapParallax != "")) {
        GameSetBackground(1, hrsCap_mapParallax, 100.0);
    }
    lv_cam = CameraInfoDefault();
    lv_p = 1;
    for ( ; lv_p <= 10 ; lv_p += 1 ) {
        if ((PlayerStatus(lv_p) == c_playerStatusActive)) {
            CameraSetValue(lv_p, c_cameraValuePitch, CameraInfoGetValue(lv_cam, c_cameraValuePitch), 0.0, -1, 10.0);
            CameraSetValue(lv_p, c_cameraValueDistance, CameraInfoGetValue(lv_cam, c_cameraValueDistance), 0.0, -1, 10.0);
            CameraSetValue(lv_p, c_cameraValueFieldOfView, CameraInfoGetValue(lv_cam, c_cameraValueFieldOfView), 0.0, -1, 10.0);
            CameraSetValue(lv_p, c_cameraValueFarClip, CameraInfoGetValue(lv_cam, c_cameraValueFarClip), 0.0, -1, 10.0);
            CameraSetValue(lv_p, c_cameraValueNearClip, CameraInfoGetValue(lv_cam, c_cameraValueNearClip), 0.0, -1, 10.0);
            CameraSetValue(lv_p, c_cameraValueYaw, CameraInfoGetValue(lv_cam, c_cameraValueYaw), 0.0, -1, 10.0);
            CameraUseHeightDisplacement(lv_p, true);
            CameraLockInput(lv_p, false);
        }
    }
    UISetMode(PlayerGroupAll(), c_uiModeConsole, c_transitionDurationImmediate);
    // The frame types the match showed at its start, and only those: every type shown rolled the
    // end credits over the map (a frame a match keeps hidden).
    lv_f = c_syncFrameTypeFirst;
    for ( ; lv_f <= c_syncFrameTypeLast ; lv_f += 1 ) {
        if (((lv_f - c_syncFrameTypeFirst) < 64)) {
            UISetFrameVisible(PlayerGroupAll(), lv_f, hrsCap_frameShown[(lv_f - c_syncFrameTypeFirst)]);
        }
    }
}

// Which interface frame types the match shows, at its start (hrsCap_Init: before the scene or
// the intro cutscene hides any), for hrsCap_Restore to put back.
void hrsCap_SaveFrames () {
    int lv_f;

    lv_f = c_syncFrameTypeFirst;
    for ( ; lv_f <= c_syncFrameTypeLast ; lv_f += 1 ) {
        if (((lv_f - c_syncFrameTypeFirst) < 64)) {
            hrsCap_frameShown[(lv_f - c_syncFrameTypeFirst)] = UIFrameVisible(hrsCap_LocalPlayer(), lv_f);
        }
    }
}

// Until the camera has stopped moving (a pan eases over several frames, the longer the further;
// a clamp at the bounds is applied at the next update): the status strip's echo of the
// camera's target is only right after this. At most 1.5 s.
void hrsCap_WaitCameraStill () {
    point lv_prev;
    point lv_now;
    int lv_n;

    lv_prev = CameraGetTarget(hrsCap_statusPlayer);
    lv_n = 0;
    while ((lv_n < 24)) {
        Wait(0.0625, c_timeReal);
        lv_now = CameraGetTarget(hrsCap_statusPlayer);
        if ((DistanceBetweenPoints(lv_now, lv_prev) < 0.02)) {
            return;
        }
        lv_prev = lv_now;
        lv_n += 1;
    }
}

//--------------------------------------------------------------------------------------------------
// The opening: gates early, the map's opening timers cut short, then the map is ready.
//--------------------------------------------------------------------------------------------------

// One of the map's opening timers to half a second from expiring, if it is running and has
// longer than that to go.
void hrsCap_CutShort (timer lp_t) {
    if ((TimerGetRemaining(lp_t) > 0.5)) {
        TimerSetElapsed(lp_t, (TimerGetDuration(lp_t) - 0.5));
        hrsCap_openingCuts += 1;
    }
}

// Once the gates have opened: for a few real seconds the map's opening timers (the countdown
// to its first objective and the steps on the way: Hanamura's payload comes 3 minutes after the
// gates) are cut short as each one starts, so the objective and what it brings are in place
// before any tile is shot; the map is then ready. (Speeding game time up instead,
// GameSetGlobalTimeScale, moved no timers: the game clock read 11 s after 10 s at 20x.)
bool hrsCap_gt_FastForward_Func (bool testConds, bool runActions) {
    int lv_n;

    if (!runActions) {
        return true;
    }
    lv_n = 0;
    while ((lv_n < FixedToInt(hrsCap_forwardSeconds * 4.0))) {
${cut_short_lines}
        Wait(0.25, c_timeReal);
        lv_n += 1;
    }
    Wait(MaxF(0.0, hrsCap_readySeconds - hrsCap_forwardSeconds), c_timeReal);
    hrsCap_ready = true;
    return true;
}

// Four times a second: units keep spawning (minions, mercenaries, objectives) and the chat line
// lingers; sweep both, cut the intro short as soon as it starts, keep the game's labels hidden,
// move the opening along, pause the animations once the map is ready, redraw the strip.
bool hrsCap_gt_Sweep_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
${skip_intro_line}    hrsCap_HideLabels();
    hrsCap_ClearUnits();
    TransmissionClearGroup(PlayerGroupAll());
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    // No camera scrolling from the mouse at a screen edge or the keys, from the start and even
    // after something (the intro's exit) has unlocked it.
    CameraLockInput(hrsCap_LocalPlayer(), true);
${event_off_lines}    // The gates sooner (GameLib's countdown, before it gets far), then the fast-forward.
    if (!libGame_gv_gameStarted && (TimerGetRemaining(libGame_gv_openTheGatesTimer) > hrsCap_gatesDelay)) {
        TimerSetElapsed(libGame_gv_openTheGatesTimer, (TimerGetDuration(libGame_gv_openTheGatesTimer) - hrsCap_gatesDelay));
    }
    if (libGame_gv_gameStarted && !hrsCap_forwardStarted) {
        hrsCap_forwardStarted = true;
        TriggerExecute(hrsCap_gt_FastForward, false, false);
    }
    if (hrsCap_ready && !hrsCap_paused) {
        hrsCap_paused = true;
        libNtve_gf_SendActorMessageToGameRegion(${map_region}, "AnimSetPausedAll");
        // No more minion waves (they walked into tiles between the shots over the light sky and black):
        // GameLib's own stop for every lane's spawning.
        libGame_gf_MinionStartStopMinionSpawnCycle(false);
    }
    hrsCap_introOn = hrsCap_IntroPlaying();
    hrsCap_ReadBox();  // a backstop for a missed text-changed event
    if (!hrsCap_boxUsed && (hrsCap_box != c_invalidDialogControlId)) {
        DialogControlRequestFocus(hrsCap_box, PlayerGroupAll());  // the match starting: until the first command
    }
    hrsCap_tick = (1 - hrsCap_tick);
    hrsCap_StatusDraw();
    return true;
}

//--------------------------------------------------------------------------------------------------
// Commands (typed into the command box). Each ends with hrsCap_Ack once its work is done, so the strip shows the
// sequence number the capture appended to it.
//--------------------------------------------------------------------------------------------------

// "tile <n> [<x> <y>]": tile n, at the given map position or the planned one. The capture
// gives the position: it re-plans the grid from the camera bounds the game applies at run time
// (an arena's are far tighter than its map file says), which it measures by sending the camera
// to two corners. Acknowledged once the camera has stopped (eased pan, clamp at the bounds):
// the strip then reports where the camera really is.
bool hrsCap_gt_Tile_Func (bool testConds, bool runActions) {
    int lv_index;
    string lv_xs;

    lv_index = StringToInt(StringWord(hrsCap_cmd, 2));
    lv_xs = StringWord(hrsCap_cmd, 3);
    if ((lv_index < 0) || (lv_index > 999) || ((lv_xs == "") && (lv_index >= hrsCap_tileCount))) {
        return true;
    }
    if (!runActions) {
        return true;
    }
    // Nothing until the intro is over, so its exit can't undo the scene (the capture keeps
    // asking until it answers).
    if (hrsCap_IntroPlaying()) {
        return true;
    }
    hrsCap_currentTile = lv_index;
    if ((lv_xs != "")) {
        hrsCap_curX = StringToFixed(lv_xs);
        hrsCap_curY = StringToFixed(StringWord(hrsCap_cmd, 4));
    }
    else {
        hrsCap_curX = hrsCap_tileX[lv_index];
        hrsCap_curY = hrsCap_tileY[lv_index];
    }
    hrsCap_ClearUnits();${bounds_line}
    hrsCap_LiftBounds();
    // The normal camera at the tile first, a few frames, so the game refits its lighting there
    // (see hrsCap_NormalCamera); then the scene and the capture camera.
    CameraPan(hrsCap_cmdPlayer, Point(hrsCap_curX, hrsCap_curY), 0.0, -1, 10.0, false);
    hrsCap_NormalCamera(hrsCap_cmdPlayer);
    Wait(hrsCap_refitWait, c_timeReal);  // real time: a map that holds game time still (an arena's selection phase) would never return
    if ((hrsCap_currentTile != lv_index)) {
        return true;  // another tile was asked for meanwhile
    }
    hrsCap_Scene();
    CameraPan(hrsCap_cmdPlayer, Point(hrsCap_curX, hrsCap_curY), 0.0, -1, 10.0, false);
    hrsCap_statusPlayer = hrsCap_cmdPlayer;
    hrsCap_WaitCameraStill();
    if ((hrsCap_currentTile != lv_index)) {
        return true;
    }
    // Ready for the kept shot: a transmission (an Immortal's voice line) puts a subtitle and its
    // backdrop on screen, outside the frames the scene hides; cleared with the messages.
    TransmissionClearGroup(PlayerGroupAll());
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    hrsCap_Ack();
    return true;
}

// "clean": the kept shot follows: camera unmoved, messages and transmissions cleared.
bool hrsCap_gt_Clean_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    // A transmission (an Immortal's voice line) puts a subtitle and its backdrop on screen,
    // outside the frames hidden by the scene; cleared right before the shot.
    TransmissionClearGroup(PlayerGroupAll());
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    hrsCap_Ack();
    return true;
}

// "black": the black skybox, for the second clean shot (difference matting: the same view
// over the light sky and over black gives each pixel's transparency). "tile" puts the light sky back (Scene).
bool hrsCap_gt_Black_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    GameSetBackground(0, "HrsSkyBlack", 100.0);
    hrsCap_skyState = 2;
    TransmissionClearGroup(PlayerGroupAll());
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    hrsCap_Ack();
    return true;
}

// Sixteen times a second: transmissions (an Immortal's voice line puts a subtitle and its backdrop
// on screen, outside the frames the scene hides) and messages cleared, so none can be in a kept
// shot (the shot follows the tile's acknowledgement by a tenth of a second).
bool hrsCap_gt_Quiet_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    TransmissionClearGroup(PlayerGroupAll());
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    return true;
}

// "sky <colour> [<layer>]" (probes): the solid-colour skybox of that name (sky.py) on layer 0
// (the camera-fixed skybox, the default) or 1 (c_backgroundTerrain, the terrain-relative
// parallax layer, which Blizzard's arenas swap). "none" clears the layer, "heaven" is
// HeavenSkybox, "mapsky" and "mapparallax" the map's own fixed and parallax sky models. At the
// animation speed "bgspeed" set (100 unless changed). Never "none" on layer 1: every run that
// emptied the parallax slot crashed the game when the match ended, even with it set again.
bool hrsCap_gt_Sky_Func (bool testConds, bool runActions) {
    string lv_colour;
    string lv_model;
    int lv_layer;

    if (!runActions) {
        return true;
    }
    lv_colour = StringWord(hrsCap_cmd, 2);
    lv_layer = StringToInt(StringWord(hrsCap_cmd, 3));
    if ((lv_colour == "none")) {
        lv_model = "";
    }
    else if ((lv_colour == "heaven")) {
        lv_model = "HeavenSkybox";
    }
    else if ((lv_colour == "mapsky")) {
        lv_model = hrsCap_mapSky;
    }
    else if ((lv_colour == "mapparallax")) {
        lv_model = hrsCap_mapParallax;
    }
    else {
        lv_model = ("HrsSky" + StringCase(StringSub(lv_colour, 1, 1), true) + StringSub(lv_colour, 2, StringLength(lv_colour)));
    }
    GameSetBackground(lv_layer, lv_model, hrsCap_bgSpeed);
    if ((lv_layer == 0) && (lv_colour == "${light_sky}")) { hrsCap_skyState = 1; }
    else if ((lv_layer == 0) && (lv_colour == "black")) { hrsCap_skyState = 2; }
    else { hrsCap_skyState = 0; }
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    hrsCap_Ack();
    return true;
}

// "pause [0]": pause every animation on the map the way Blizzard's maps do at game over (the
// whole-map actor message plus UnitPauseAll), "0" to resume. The sweep pauses them by itself
// once the map is ready; the capture sends this only if the map never reports ready.
bool hrsCap_gt_Pause_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if ((StringWord(hrsCap_cmd, 2) == "0")) {
        libNtve_gf_SendActorMessageToGameRegion(${map_region}, "AnimSetPausedAll 0");
        UnitPauseAll(false);
    }
    else {
        libNtve_gf_SendActorMessageToGameRegion(${map_region}, "AnimSetPausedAll");
        UnitPauseAll(true);
    }
    hrsCap_Ack();
    return true;
}

// "move <n> <x> <y>" (--probe-light): like "tile" but without the scene set-up (the vision
// reveal, camera re-application, interface hiding, sky, doodad hiding), to tell what that costs.
bool hrsCap_gt_Move_Func (bool testConds, bool runActions) {
    int lv_index;

    if (!runActions) {
        return true;
    }
    lv_index = StringToInt(StringWord(hrsCap_cmd, 2));
    hrsCap_currentTile = lv_index;
    hrsCap_curX = StringToFixed(StringWord(hrsCap_cmd, 3));
    hrsCap_curY = StringToFixed(StringWord(hrsCap_cmd, 4));
    CameraPan(hrsCap_cmdPlayer, Point(hrsCap_curX, hrsCap_curY), 0.0, -1, 10.0, false);
    hrsCap_NormalCamera(hrsCap_cmdPlayer);
    Wait(0.25, c_timeReal);
    hrsCap_ApplyCamera(hrsCap_cmdPlayer);
    CameraPan(hrsCap_cmdPlayer, Point(hrsCap_curX, hrsCap_curY), 0.0, -1, 10.0, false);
    hrsCap_statusPlayer = hrsCap_cmdPlayer;
    hrsCap_WaitCameraStill();
    hrsCap_Ack();
    return true;
}

// "look <x> <y>" (--probe-light): point the camera at that map position, nothing else.
bool hrsCap_gt_Look_Func (bool testConds, bool runActions) {
    fixed lv_x;
    fixed lv_y;

    if (!runActions) {
        return true;
    }
    lv_x = StringToFixed(StringWord(hrsCap_cmd, 2));
    lv_y = StringToFixed(StringWord(hrsCap_cmd, 3));
    CameraPan(hrsCap_cmdPlayer, Point(lv_x, lv_y), 0.0, -1, 10.0, false);
    hrsCap_Ack();
    return true;
}

// "fov <degrees>" (--probe-sky-reach): the camera's field of view, until the next "tile" puts the
// capture camera's back. Probe: how much more of the sky shells a wider lens sees from where the
// camera can go.
bool hrsCap_gt_Fov_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    CameraSetValue(hrsCap_cmdPlayer, c_cameraValueFieldOfView, StringToFixed(StringWord(hrsCap_cmd, 2)), 0.0, -1, 10.0);
    hrsCap_Ack();
    return true;
}

// "clip <near> <far>" (--probe-light): the camera's clip planes, until the next "tile" puts the
// capture camera's back. Probe: does a near clip past the ground (the camera is about 214 units
// out) leave only the skybox?
bool hrsCap_gt_Clip_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    CameraSetValue(hrsCap_cmdPlayer, c_cameraValueNearClip, StringToFixed(StringWord(hrsCap_cmd, 2)), 0.0, -1, 10.0);
    CameraSetValue(hrsCap_cmdPlayer, c_cameraValueFarClip, StringToFixed(StringWord(hrsCap_cmd, 3)), 0.0, -1, 10.0);
    hrsCap_Ack();
    return true;
}

// "hidemap <near clip>" (the sky passes): the map clipped away at that distance (far clip 5000),
// sky swaps at speed 1 (frozen), our sky taken down: what three commands did, in one.
bool hrsCap_gt_HideMap_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    CameraSetValue(hrsCap_cmdPlayer, c_cameraValueNearClip, StringToFixed(StringWord(hrsCap_cmd, 2)), 0.0, -1, 10.0);
    CameraSetValue(hrsCap_cmdPlayer, c_cameraValueFarClip, 5000.0, 0.0, -1, 10.0);
    hrsCap_bgSpeed = 1.0;
    GameSetBackground(0, "", hrsCap_bgSpeed);
    hrsCap_skyState = 0;
    hrsCap_Ack();
    return true;
}

// "refitwait <seconds>" (probes): how long the lighting-refit look is held before each tile.
bool hrsCap_gt_RefitWait_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    hrsCap_refitWait = StringToFixed(StringWord(hrsCap_cmd, 2));
    hrsCap_Ack();
    return true;
}

// "unbound": lift the camera bounds to the whole map from now on (see hrsCap_LiftBounds).
bool hrsCap_gt_Unbound_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    hrsCap_unbound = true;
    hrsCap_LiftBounds();
    hrsCap_Ack();
    return true;
}

// "bgspeed <percent>" (probes): the animation speed the following "sky" commands give their
// background (GameSetBackground's last argument; 0 to try freezing a sky's own animation).
bool hrsCap_gt_BgSpeed_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    hrsCap_bgSpeed = StringToFixed(StringWord(hrsCap_cmd, 2));
    hrsCap_Ack();
    return true;
}

// The command's words from lp_from on, without its last (the sequence number), one space apart.
string hrsCap_CommandWords (int lp_from) {
    string lv_text;
    string lv_word;
    int lv_n;

    lv_text = "";
    lv_n = lp_from;
    for ( ; lv_n <= 16 ; lv_n += 1 ) {
        lv_word = StringWord(hrsCap_cmd, lv_n);
        if ((lv_word == "") || (StringWord(hrsCap_cmd, (lv_n + 1)) == "")) {
            break;
        }
        if ((lv_text != "")) {
            lv_text = (lv_text + " ");
        }
        lv_text = (lv_text + lv_word);
    }
    return lv_text;
}

// "note <text>" (at most 15 words): the note shown with that text; "note" alone: hidden.
bool hrsCap_gt_Note_Func (bool testConds, bool runActions) {
    string lv_text;

    if (!runActions) {
        return true;
    }
    lv_text = hrsCap_CommandWords(2);
    if ((lv_text == "")) {
        hrsCap_NoteHide();
    }
    else {
        hrsCap_NoteShow(lv_text);
    }
    hrsCap_Ack();
    return true;
}

// The elements probe (--probe-elements, ELEMENTS-PLAN.md): the map's structures, camps and
// objective one at a time. The structure nearest a cell (within 3 cells), never a copy ("el copy":
// one may stand on its structure's own cell), or null.
unit hrsCap_StructureAt (fixed lp_x, fixed lp_y) {
    unitgroup lv_g;
    int lv_i;

    lv_g = UnitGroup(null, c_playerAny, RegionCircle(Point(lp_x, lp_y), 3.0), UnitFilter((1 << c_targetFilterStructure), 0, 0, 0), 0);
    lv_i = 0;
    for ( ; lv_i < 128 ; lv_i += 1 ) {
        if ((hrsCap_copies[lv_i] != null)) {
            UnitGroupRemove(lv_g, hrsCap_copies[lv_i]);
        }
    }
    return UnitGroupClosestToPoint(lv_g, Point(lp_x, lp_y));
}

// Fades from word lp_from of the command on, three words each, "<x> <y> <opacity>" (the sequence
// number after them never part of one): the structure nearest each cell faded to that opacity at
// once, every actor of its own (as "scopemsg <x> <y> SetOpacity <opacity> 0"). Several in one
// command: the elements capture's round trips.
void hrsCap_FadeTriples (int lp_from) {
    int lv_w;
    unit lv_unit;

    lv_w = lp_from;
    while ((StringWord(hrsCap_cmd, (lv_w + 3)) != "")) {
        lv_unit = hrsCap_StructureAt(StringToFixed(StringWord(hrsCap_cmd, lv_w)), StringToFixed(StringWord(hrsCap_cmd, (lv_w + 1))));
        if ((lv_unit != null)) {
            ActorScopeSend(ActorScopeFromUnit(lv_unit), ("SetOpacity " + StringWord(hrsCap_cmd, (lv_w + 2)) + " 0"));
        }
        lv_w += 3;
    }
}

// A structure shown or hidden (hidden: the unit's hidden state, so it can be shown again), and
// every actor of its own with it: a core's orbiting shield crystals and its shield's aura are
// actors of its own that hiding the unit leaves.
void hrsCap_ShowStructure (unit lp_unit, bool lp_show) {
    libNtve_gf_ShowHideUnit(lp_unit, lp_show);
    if (lp_show) {
        ActorScopeSend(ActorScopeFromUnit(lp_unit), "SetVisibility 1");
    }
    else {
        ActorScopeSend(ActorScopeFromUnit(lp_unit), "SetVisibility 0");
    }
}

// Every structure shown or hidden (hrsCap_ShowStructure).
void hrsCap_ShowAllStructures (bool lp_show) {
    unitgroup lv_g;
    int lv_u;
    unit lv_unit;

    lv_g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, 0, 0), 0);
    lv_u = UnitGroupCount(lv_g, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_g, lv_u);
        if (lv_unit == null) { break; }
        hrsCap_ShowStructure(lv_unit, lp_show);
    }
}

// Every standing structure but the copies faded out or in, its own actors with it ("el fadeall":
// the elements capture's standing shots). Its opacity, not its visibility: hidden and shown again
// while paused, a structure gives off no particles until it plays, but faded out and in it comes
// back exactly as it was (probed: effects, a core's shield crystals and all).
void hrsCap_FadeAllStructures (bool lp_in) {
    unitgroup lv_g;
    int lv_u;
    unit lv_unit;

    lv_g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    lv_u = 0;
    for ( ; lv_u < 128 ; lv_u += 1 ) {
        if ((hrsCap_copies[lv_u] != null)) {
            UnitGroupRemove(lv_g, hrsCap_copies[lv_u]);
        }
    }
    lv_u = UnitGroupCount(lv_g, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_g, lv_u);
        if (lv_unit == null) { break; }
        UnitSetState(lv_unit, c_unitStateHighlightable, false);  // never outlined under the mouse
        if (lp_in) {
            ActorScopeSend(ActorScopeFromUnit(lv_unit), "SetOpacity 1 0");
        }
        else {
            ActorScopeSend(ActorScopeFromUnit(lv_unit), "SetOpacity 0 0");
        }
    }
}

// An actor message to every structure's main actor (how --structures hide hides them:
// "SetVisibility").
void hrsCap_StructuresMessage (string lp_message) {
    unitgroup lv_g;
    int lv_u;
    unit lv_unit;

    lv_g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, 0, 0), 0);
    lv_u = UnitGroupCount(lv_g, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_g, lv_u);
        if (lv_unit == null) { break; }
        ActorSend(libNtve_gf_MainActorofUnit(lv_unit), lp_message);
    }
}

// Structures brought down without what a fall sets off for the players: GameLib plants a loot
// banner (its waving flag, a red glow) in a fallen town hall's rubble while this is on (set again
// before every fall, in case GameLib sets it), and gives XP (with its floating text) while its XP
// switch is on and the unit hasn't UnitGivesNoXP (given to each structure before it falls).
bool hrsCap_quietBanner = true;  // "el quiet <banner> <xp>" (the elements probe): either part off
bool hrsCap_quietXP = true;

void hrsCap_QuietFalls () {
    if (hrsCap_quietBanner) {
        libGame_gv_loot_DropBannerInTownHallRubble = false;
    }
    if (hrsCap_quietXP) {
        libCore_gv_sYSXPOn = false;  // GameLib's XP switch: no XP, and none of its floating text, from any kill
        // A fallen fort's or keep's "PERIODIC/CONSTANT CATAPULTS & XP" text (GameLib's
        // libGame_gt_TownStructureDies shows it unless the map never spawns catapults).
        libGame_gv_minionMapNeverSpawnsCatapults = true;
    }
}

// A structure brought down where it can be seen: shown, its animations running for its death. A
// tower doesn't die: as the game does when one falls, it gets TownCannonTowerInvulnerable and
// morphs into TownCannonTowerDead, its rubble (the AI library orders that morph; ordered here too).
// Anything else is killed.
void hrsCap_Kill (unit lp_unit) {
    hrsCap_QuietFalls();
    if (hrsCap_quietXP) {
        UnitBehaviorAdd(lp_unit, "UnitGivesNoXP", lp_unit, 1);
    }
    // Shown with its own actors (hidden with them by "el hideall"): shown as a unit only, its
    // actors stayed invisible, and so did all its rubble.
    hrsCap_ShowStructure(lp_unit, true);
    libNtve_gf_SendActorMessageToUnit(lp_unit, "AnimSetPausedAll 0");
    // By the ability, not the Tower attribute: town halls have the attribute too (they shoot), but
    // no TowerDeadMorph, and ordered it they never fell.
    if (UnitAbilityExists(lp_unit, "TowerDeadMorph")) {
        UnitBehaviorAdd(lp_unit, "TownCannonTowerInvulnerable", lp_unit, 1);
        UnitIssueOrder(lp_unit, Order(AbilityCommand("TowerDeadMorph", 0)), c_orderQueueReplace);
    }
    else {
        UnitKill(lp_unit);
    }
}

// One structure brought down, then, after lp_wait real seconds, the map's animations paused again
// (its rubble with them); a wait below 0: not paused (the elements capture brings a wave down,
// waits once and pauses with "el freeze").
void hrsCap_KillShown (unit lp_unit, fixed lp_wait) {
    hrsCap_Kill(lp_unit);
    if ((lp_wait < 0.0)) {
        return;
    }
    Wait(lp_wait, c_timeReal);
    libNtve_gf_SendActorMessageToGameRegion(${map_region}, "AnimSetPausedAll");
}

// The elements probe: ways of bringing a town hall down (killed outright its actor keeps the
// standing model). 0: as hrsCap_Kill; 1: shown, then killed a quarter of a second later; 2: lethal
// damage from the enemy team's core; 3: its life set to nothing.
void hrsCap_KillHow (int lp_how, unit lp_unit, fixed lp_wait) {
    libNtve_gf_ShowHideUnit(lp_unit, true);
    libNtve_gf_SendActorMessageToUnit(lp_unit, "AnimSetPausedAll 0");
    if ((lp_how == 0)) {
        UnitKill(lp_unit);
    }
    else {
        Wait(0.25, c_timeReal);
        if ((lp_how == 1)) {
            UnitKill(lp_unit);
        }
        else if ((lp_how == 2)) {
            UnitDamage(libGame_gv_teams[libGame_gf_EnemyTeamNumberOfPlayer(UnitGetOwner(lp_unit))].lv_core, "HeroGenericFakeHeroDuplicationDamage", lp_unit, 1000000.0);
        }
        else {
            UnitSetPropertyFixed(lp_unit, c_unitPropLife, 0.0);
        }
    }
    Wait(lp_wait, c_timeReal);
    libNtve_gf_SendActorMessageToGameRegion(${map_region}, "AnimSetPausedAll");
}

// Every structure brought down but the two teams' cores (by then the hidden replacements "el core"
// put in their place, which nothing may kill: the match would end), then the animations paused
// again after lp_wait real seconds.
void hrsCap_KillAll (fixed lp_wait) {
    unitgroup lv_g;
    int lv_u;
    unit lv_unit;

    lv_g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    lv_u = UnitGroupCount(lv_g, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_g, lv_u);
        if (lv_unit == null) { break; }
        if ((lv_unit != libGame_gv_teams[libGame_gv_teamOrderIndex_C].lv_core) && (lv_unit != libGame_gv_teams[libGame_gv_teamChaosIndex_C].lv_core)) {
            hrsCap_Kill(lv_unit);
        }
    }
    Wait(lp_wait, c_timeReal);
    libNtve_gf_SendActorMessageToGameRegion(${map_region}, "AnimSetPausedAll");
}

// An actor message to every doodad on the map, as libNtve_gf_ShowHideDoodadsInRegion sends one
// to a doodad type ("SetVisibility 0" / "SetVisibility 1": hidden, shown again).
void hrsCap_DoodadsMessage (string lp_message) {
    actor lv_region;

    ActorRegionCreate(null, "TriggerRegion", ${map_region});
    lv_region = libNtve_gf_ActorLastCreated();
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, lp_message, "Doodad", "");
    ActorScopeKill(ActorScopeFromActor(lv_region));
}

// The holes in the terrain the cores stand on: filled in the map file (inject.py), opened here over
// exactly their cells as the script starts, so the map looks as the game draws it (the sky through
// a core's centre); shown on "el holes show" (the ground where a core stood, once it's gone).
region hrsCap_holes;
bool hrsCap_holesShown = false;

void hrsCap_HolesInit () {
    if (!${has_holes}) {
        return;
    }
    hrsCap_holes = RegionEmpty();${hole_lines}
    TerrainShowRegion(hrsCap_holes, false);
}

// The holes as they should be now, after anything that showed all the terrain: open, unless "el
// holes show" showed them.
void hrsCap_OpenHoles () {
    if ((hrsCap_holes != null) && !hrsCap_holesShown) {
        TerrainShowRegion(hrsCap_holes, false);
    }
}

// "el isolate": every unit in sight outside a circle round what is on show hidden, and kept here
// to be shown again (units already hidden, as the structures "el hideall" hid, aren't touched);
// and the loot banners outside it too (a banner is a model of its own, which hiding its stand
// leaves), shown again with it. Only the banners: an actor-region message reaches every actor whose
// bounds touch the region, and a fallen structure's rubble (a model, its bounds wide) at the
// circle's middle would go with them.
unitgroup hrsCap_isolatedUnits;
// Whether isolating hides the elements' structures too ("el env off" leaves them, every other
// structure hidden: the elements capture fades them by opacity instead, since hiding one and
// showing it again restarts its animations, a level 3 tower's into its birth, and loses its
// particles).
bool hrsCap_isolateStructures = true;

// One of the elements' structures (elements.is_structure: a town's, Town..., or a core, ...Core);
// the map's other structures (hidden figures it keeps) are hidden with the rest by "el env off".
bool hrsCap_IsElementStructure (unit lp_unit) {
    string lv_type;

    lv_type = UnitGetType(lp_unit);
    if ((StringSub(lv_type, 1, 4) == "Town")) {
        return true;
    }
    return (StringLength(lv_type) >= 4) && (StringSub(lv_type, StringLength(lv_type) - 3, StringLength(lv_type)) == "Core");
}
region hrsCap_isolatedArea;

// An actor message to every loot banner in a region (the actors in a LootBanner's scope).
void hrsCap_BannersMessage (region lp_area, string lp_message) {
    actor lv_region;

    ActorRegionCreate(null, "TriggerRegion", lp_area);
    lv_region = libNtve_gf_ActorLastCreated();
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, lp_message, "Model", "ScopeContains LootBanner");
    ActorScopeKill(ActorScopeFromActor(lv_region));
}

void hrsCap_IsolateUnits (fixed lp_x, fixed lp_y, fixed lp_radius) {
    region lv_outside;
    int lv_u;
    unit lv_unit;

    lv_outside = ${map_region};
    RegionAddCircle(lv_outside, false, Point(lp_x, lp_y), lp_radius);
    hrsCap_isolatedArea = lv_outside;
    hrsCap_BannersMessage(lv_outside, "SetVisibility 0");
    hrsCap_isolatedUnits = UnitGroup(null, c_playerAny, lv_outside, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_u = UnitGroupCount(hrsCap_isolatedUnits, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(hrsCap_isolatedUnits, lv_u);
        if (lv_unit == null) { break; }
        if (!hrsCap_isolateStructures && hrsCap_IsElementStructure(lv_unit)) {
            UnitGroupRemove(hrsCap_isolatedUnits, lv_unit);
        }
        else {
            libNtve_gf_ShowHideUnit(lv_unit, false);
        }
    }
}

void hrsCap_RestoreUnits () {
    int lv_u;
    unit lv_unit;

    if ((hrsCap_isolatedUnits == null)) {
        return;
    }
    lv_u = UnitGroupCount(hrsCap_isolatedUnits, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(hrsCap_isolatedUnits, lv_u);
        if (lv_unit == null) { break; }
        libNtve_gf_ShowHideUnit(lv_unit, true);
    }
    hrsCap_isolatedUnits = null;
    if ((hrsCap_isolatedArea != null)) {
        hrsCap_BannersMessage(hrsCap_isolatedArea, "SetVisibility 1");
        hrsCap_isolatedArea = null;
    }
}

// Every fallen structure's remains taken away, as Blizzard's own maps clear a destroyed town (the
// tutorial's town reset, libNtve_gf_RemoveDeathModelsinRegion): the towers' rubble units removed,
// the death models destroyed (aliases _DeathModel; the gates' _Clearable; _DeadClearable), and
// the debris and smoke particles still in the world. A structure's ground patch goes with it
// (the patch stays under a structure that is only hidden).
void hrsCap_ClearRemains () {
    unitgroup lv_g;
    int lv_u;
    unit lv_unit;
    actor lv_region;

    lv_g = UnitGroup("TownCannonTowerDead", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
    lv_u = UnitGroupCount(lv_g, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_g, lv_u);
        if (lv_unit == null) { break; }
        UnitRemove(lv_unit);
    }
    ActorRegionCreate(null, "TriggerRegion", ${map_region});
    lv_region = libNtve_gf_ActorLastCreated();
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, "Destroy", "Model", "ScopeContains _DeathModel");
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, "Destroy", "Unit", "ScopeContains _DeathModel");
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, "Destroy", "Model", "ScopeContains _Clearable");
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, "Destroy", "Unit", "ScopeContains _Clearable");
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, "Destroy", "Model", "ScopeContains _DeadClearable");
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, "Destroy", "Unit", "ScopeContains _DeadClearable");
    ActorWorldParticleFXDestroy();
    ActorScopeKill(ActorScopeFromActor(lv_region));
}

// Every fallen town structure's own actor destroyed: a town hall's stays after its death (its
// actor prepares its death sequence with PreventKill) and goes on drawing its dark patch on the
// ground. Blizzard's town actors destroy themselves on this signal (TownBaseStructure's
// "Signal.*.ClearTownStructureDeathModel"); a standing structure's would too, so "el clear all" is
// for once every structure but the replacement cores (not town actors) is down.
void hrsCap_ClearFallenActors () {
    actor lv_region;

    ActorRegionCreate(null, "TriggerRegion", ${map_region});
    lv_region = libNtve_gf_ActorLastCreated();
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, "Signal ClearTownStructureDeathModel", "Unit", "");
    ActorScopeKill(ActorScopeFromActor(lv_region));
}

// An actor message to the fallen structures' remains (the actors whose scope contains _DeathModel,
// as hrsCap_ClearRemains reaches them; a town hall's own actor among them) in a circle, by their
// centres or by contact ("el dmsg"). By centre, a small circle on a structure's cell leaves its
// neighbours' remains alone (c_actorIntersectAgainstCenter: in the game's table of constants,
// though Blizzard's scripts only use the radius contact). Hiding the unit leaves them showing.
void hrsCap_RemainsMessage (bool lp_byCentre, fixed lp_x, fixed lp_y, fixed lp_radius, string lp_message) {
    actor lv_region;

    ActorRegionCreate(null, "TriggerRegion", RegionCircle(Point(lp_x, lp_y), lp_radius));
    lv_region = libNtve_gf_ActorLastCreated();
    if (lp_byCentre) {
        ActorRegionSend(lv_region, c_actorIntersectAgainstCenter, lp_message, "Model", "ScopeContains _DeathModel");
        ActorRegionSend(lv_region, c_actorIntersectAgainstCenter, lp_message, "Unit", "ScopeContains _DeathModel");
    }
    else {
        ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, lp_message, "Model", "ScopeContains _DeathModel");
        ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, lp_message, "Unit", "ScopeContains _DeathModel");
    }
    ActorScopeKill(ActorScopeFromActor(lv_region));
}

// A fallen tower's remains (the TownCannonTowerDead unit its fall turns it into) within 3 cells of
// a cell, hidden or shown ("el deadunit").
void hrsCap_ShowDeadTowers (fixed lp_x, fixed lp_y, bool lp_show) {
    unitgroup lv_g;
    int lv_u;
    unit lv_unit;

    lv_g = UnitGroup("TownCannonTowerDead", c_playerAny, RegionCircle(Point(lp_x, lp_y), 3.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
    lv_u = UnitGroupCount(lv_g, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_g, lv_u);
        if (lv_unit == null) { break; }
        hrsCap_ShowStructure(lv_unit, lp_show);
    }
}

${isolate_function}
// "el <verb> ...", the map's elements (ELEMENTS-PLAN.md; the elements capture and its probe):
// "hideall", "showall"; "show <x> <y>", "hide <x> <y>" (the structure nearest the cell);
// "kill <x> <y> <seconds>" (brought down, its rubble left; seconds below 0: not paused after);
// "killhow <0-3> <x> <y> <seconds>" (the probe's ways of bringing a town hall down); "scopemsg <x>
// <y> <actor message>" (to every actor of the structure nearest the cell); "fades <x> <y> <opacity> ..."
// (each structure nearest a cell faded, up to four in one command; "at" takes them too, after its
// cell, faded before the camera moves); "behave <x> <y>
// <behaviour> 1|0" (added to or removed from it); "pauseable 1|0"; "scene
// <actor message>" (to the scene actor, ::Scene: SceneParticlesDestroy and the like); "at <x> <y>"
// (the camera straight above the cell, its lighting refitted, without the rest of "tile"'s scene); "quiet
// <banner 0|1> <xp 0|1>" (whether a fall plants no loot banner, gives no XP: both on by default); "killall <seconds>" (every structure
// but the two cores); "core <team> <seconds>" (the team's core killed after a hidden replacement
// takes its place as the team's core, so nothing ends the match: everything that would listens
// for the death of whatever that variable holds; the replacement has no model); "clear" (every
// fallen structure's remains taken away; "clear all": and the fallen town structures' own actors,
// once every structure is down); "keep 1|0" (the sweep leaves camps and objectives alone); "camp <n>" (0: every camp)
// spawned as its respawn timer would; "freeze" (animations paused again and units paused: what
// spawned since); "copy <n> make <x> <y> <to x> <to y>" (copy n of the structure nearest the
// cell, the same type, owner and facing, standing at the other cell, which may be its own), "copy
// <n> kill|show|hide|play" (copy n brought down, shown, hidden, its animations let run: by number,
// as a copy on its structure's own cell can't be told from it by place); "fadeall 0|1" (every
// standing structure but the copies faded out or in: hidden without losing its effects; one is
// faded with "scopemsg <x> <y> SetOpacity 1 0"); "wide <x> <y> <distance>" (the camera far back
// straight above the cell: the probes); "copykill <from> <to>"
// (copies from..to brought down at once: the elements capture's rubble, prepared on spare spots
// while the structures stand, each group falling at its own moment); "dmsg c|r <x> <y> <radius> <actor message>"
// (the message to the remains in the circle, by centre or by contact); "deadunit <x> <y> 0|1" (a
// fallen tower's remains hidden or shown); "play" (every animation let run again, units left paused: what was shown while
// paused gives off no particles until it plays, the models freezing theirs with their animations); "boss <team> <x> <y>" (the map's objective unit, where the map has one we
// know); "terrain show|hide <x> <y> <radius>" (the terrain in a circle); "holes show|hide" (the
// holes the cores stand on, filled in the map file: the ground where a core stood, or open as the
// game draws them); "isolate on <x> <y> <radius>" / "isolate off" (all the terrain, every doodad,
// and every unit in sight and loot banner outside the circle hidden, or shown again: what is left
// stands alone over the sky); "env off|on" (the same with nothing kept, and the environment's
// terrain, doodads and water switched off: the whole scene but what is shown, for the elements
// capture); "msg <actor message>" to the whole map, "smsg <actor
// message>" to every structure, "umsg <x> <y> <actor message>" to the structure nearest the cell.
bool hrsCap_gt_Element_Func (bool testConds, bool runActions) {
    string lv_verb;
    unit lv_unit;
    unit lv_core;
    unitgroup lv_g;
    int lv_u;
    int lv_n;
    int lv_team;

    if (!runActions) {
        return true;
    }
    lv_verb = StringWord(hrsCap_cmd, 2);
    if ((lv_verb == "hideall")) {
        hrsCap_ShowAllStructures(false);
    }
    else if ((lv_verb == "showall")) {
        hrsCap_ShowAllStructures(true);
    }
    else if ((lv_verb == "show") || (lv_verb == "hide") || (lv_verb == "kill")) {
        lv_unit = hrsCap_StructureAt(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4)));
        if ((lv_unit != null)) {
            if ((lv_verb == "kill")) {
                hrsCap_KillShown(lv_unit, StringToFixed(StringWord(hrsCap_cmd, 5)));
            }
            else {
                hrsCap_ShowStructure(lv_unit, (lv_verb == "show"));
            }
        }
    }
    else if ((lv_verb == "core")) {
        lv_team = StringToInt(StringWord(hrsCap_cmd, 3));
        lv_core = libGame_gv_teams[lv_team].lv_core;
        UnitCreate(1, UnitGetType(lv_core), c_unitCreateIgnorePlacement, UnitGetOwner(lv_core), UnitGetPosition(lv_core), UnitGetFacing(lv_core), null);
        libNtve_gf_ShowHideUnit(UnitLastCreated(), false);
        // No model at all: a structure hidden after being shown ("el showall") leaves the dark patch
        // its model draws on the ground; with no model, nothing of it is ever drawn.
        ActorSend(libNtve_gf_MainActorofUnit(UnitLastCreated()), "ModelSwap Invisible");
        libGame_gv_teams[lv_team].lv_core = UnitLastCreated();
        hrsCap_KillShown(lv_core, StringToFixed(StringWord(hrsCap_cmd, 4)));
    }
    else if ((lv_verb == "at")) {
        // The camera straight above a cell, as "tile" puts it but without the rest of its scene (the
        // reveal and the hidden interface hold from the last tile): the lighting refitted there
        // first (without it, structures away from the last refit came out duller: the keeps' glows
        // half gone), then the capture camera (pitch, distance, lens and clip planes: a sky shot's
        // "hidemap" pushes the near clip past the ground), the light sky put back. For the
        // elements, shot with the scene hidden. Any "<x> <y> <opacity>" after the cell: those
        // structures faded first (hrsCap_FadeTriples).
        hrsCap_FadeTriples(5);
        CameraPan(hrsCap_cmdPlayer, Point(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4))), 0.0, -1, 10.0, false);
        hrsCap_NormalCamera(hrsCap_cmdPlayer);
        Wait(hrsCap_refitWait, c_timeReal);
        hrsCap_ApplyCamera(hrsCap_cmdPlayer);
        CameraPan(hrsCap_cmdPlayer, Point(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4))), 0.0, -1, 10.0, false);
        hrsCap_statusPlayer = hrsCap_cmdPlayer;
        hrsCap_WaitCameraStill();
        GameSetBackground(0, "${light_sky_model}", 100.0);
        hrsCap_skyState = 1;
        TransmissionClearGroup(PlayerGroupAll());
    }
    else if ((lv_verb == "scopemsg")) {
        // An actor message to every actor of the structure nearest the cell (the probes).
        lv_unit = hrsCap_StructureAt(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4)));
        if ((lv_unit != null)) {
            ActorScopeSend(ActorScopeFromUnit(lv_unit), hrsCap_CommandWords(5));
        }
    }
    else if ((lv_verb == "fades")) {
        // Several structures faded at once, "<x> <y> <opacity>" each (hrsCap_FadeTriples).
        hrsCap_FadeTriples(3);
    }
    else if ((lv_verb == "behave")) {
        // A behaviour added to (1) or removed from (0) the structure nearest the cell (the probes:
        // a time stop's own time scale, as Void Prison's).
        lv_unit = hrsCap_StructureAt(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4)));
        if ((lv_unit != null) && (StringWord(hrsCap_cmd, 6) == "1")) {
            UnitBehaviorAdd(lv_unit, StringWord(hrsCap_cmd, 5), lv_unit, 1);
        }
        else if ((lv_unit != null)) {
            UnitBehaviorRemove(lv_unit, StringWord(hrsCap_cmd, 5), 1);
        }
    }
    else if ((lv_verb == "pauseable")) {
        GameSetPauseable((StringWord(hrsCap_cmd, 3) == "1"));  // whether the game may be paused (the probes)
    }
    else if ((lv_verb == "scene")) {
        ActorSend(ActorFrom("::Scene"), hrsCap_CommandWords(3));  // an actor message to the scene itself (the probes)
    }
    else if ((lv_verb == "killhow")) {
        lv_unit = hrsCap_StructureAt(StringToFixed(StringWord(hrsCap_cmd, 4)), StringToFixed(StringWord(hrsCap_cmd, 5)));
        if ((lv_unit != null)) {
            hrsCap_KillHow(StringToInt(StringWord(hrsCap_cmd, 3)), lv_unit, StringToFixed(StringWord(hrsCap_cmd, 6)));
        }
    }
    else if ((lv_verb == "quiet")) {
        hrsCap_quietBanner = (StringWord(hrsCap_cmd, 3) == "1");
        hrsCap_quietXP = (StringWord(hrsCap_cmd, 4) == "1");
        libGame_gv_loot_DropBannerInTownHallRubble = !hrsCap_quietBanner;
        libCore_gv_sYSXPOn = !hrsCap_quietXP;
    }
    else if ((lv_verb == "killall")) {
        hrsCap_KillAll(StringToFixed(StringWord(hrsCap_cmd, 3)));
    }
    else if ((lv_verb == "clear")) {
        hrsCap_ClearRemains();
        if ((StringWord(hrsCap_cmd, 3) == "all")) {
            hrsCap_ClearFallenActors();
        }
    }
    else if ((lv_verb == "keep")) {
        hrsCap_keepCreeps = (StringWord(hrsCap_cmd, 3) == "1");
    }
    else if ((lv_verb == "camp")) {
        lv_n = StringToInt(StringWord(hrsCap_cmd, 3));
        if ((lv_n > 0)) {
            libMapM_gf_JungleRespawnCreepsForCamp(lv_n);
        }
        else {
            lv_n = 1;
            for ( ; lv_n <= libMapM_gv_jungleNumberOfCreepCamps ; lv_n += 1 ) {
                libMapM_gf_JungleRespawnCreepsForCamp(lv_n);
            }
        }
    }
    else if ((lv_verb == "copy")) {
        lv_n = StringToInt(StringWord(hrsCap_cmd, 3));
        if ((StringWord(hrsCap_cmd, 4) == "make")) {
            lv_unit = hrsCap_StructureAt(StringToFixed(StringWord(hrsCap_cmd, 5)), StringToFixed(StringWord(hrsCap_cmd, 6)));
            if ((lv_unit != null)) {
                UnitCreate(1, UnitGetType(lv_unit), c_unitCreateIgnorePlacement, UnitGetOwner(lv_unit),
                           Point(StringToFixed(StringWord(hrsCap_cmd, 7)), StringToFixed(StringWord(hrsCap_cmd, 8))), UnitGetFacing(lv_unit), null);
                hrsCap_copies[lv_n] = UnitLastCreated();
                UnitSetState(hrsCap_copies[lv_n], c_unitStateHighlightable, false);
            }
        }
        else if ((hrsCap_copies[lv_n] != null)) {
            if ((StringWord(hrsCap_cmd, 4) == "kill")) {
                hrsCap_Kill(hrsCap_copies[lv_n]);
            }
            else if ((StringWord(hrsCap_cmd, 4) == "play")) {
                ActorScopeSend(ActorScopeFromUnit(hrsCap_copies[lv_n]), "AnimSetPausedAll 0");
            }
            else {
                hrsCap_ShowStructure(hrsCap_copies[lv_n], (StringWord(hrsCap_cmd, 4) == "show"));
            }
        }
    }
    else if ((lv_verb == "wide")) {
        // The camera far back straight above a cell, the whole map in view (the probes: does a
        // structure falling in view but far from the camera give off its particles?). "at" puts
        // the capture camera back.
        CameraPan(hrsCap_cmdPlayer, Point(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4))), 0.0, -1, 10.0, false);
        CameraSetValue(hrsCap_cmdPlayer, c_cameraValueDistance, StringToFixed(StringWord(hrsCap_cmd, 5)), 0.0, -1, 10.0);
        CameraSetValue(hrsCap_cmdPlayer, c_cameraValueFarClip, (StringToFixed(StringWord(hrsCap_cmd, 5)) * 2.0), 0.0, -1, 10.0);
        hrsCap_statusPlayer = hrsCap_cmdPlayer;
        hrsCap_WaitCameraStill();
    }
    else if ((lv_verb == "fadeall")) {
        hrsCap_FadeAllStructures((StringWord(hrsCap_cmd, 3) == "1"));
    }
    else if ((lv_verb == "copykill")) {
        lv_n = StringToInt(StringWord(hrsCap_cmd, 3));
        for ( ; lv_n <= StringToInt(StringWord(hrsCap_cmd, 4)) ; lv_n += 1 ) {
            if ((hrsCap_copies[lv_n] != null)) {
                hrsCap_Kill(hrsCap_copies[lv_n]);
            }
        }
    }
    else if ((lv_verb == "dmsg")) {
        hrsCap_RemainsMessage((StringWord(hrsCap_cmd, 3) == "c"), StringToFixed(StringWord(hrsCap_cmd, 4)), StringToFixed(StringWord(hrsCap_cmd, 5)),
                              StringToFixed(StringWord(hrsCap_cmd, 6)), hrsCap_CommandWords(7));
    }
    else if ((lv_verb == "deadunit")) {
        hrsCap_ShowDeadTowers(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4)), (StringWord(hrsCap_cmd, 5) == "1"));
    }
    else if ((lv_verb == "play")) {
        libNtve_gf_SendActorMessageToGameRegion(${map_region}, "AnimSetPausedAll 0");
    }
    else if ((lv_verb == "freeze")) {
        libNtve_gf_SendActorMessageToGameRegion(${map_region}, "AnimSetPausedAll");
        lv_g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, ((1 << c_targetFilterStructure) | (1 << c_targetFilterMissile)), 0), 0);
        lv_u = UnitGroupCount(lv_g, c_unitCountAll);
        for (;; lv_u -= 1) {
            lv_unit = UnitGroupUnitFromEnd(lv_g, lv_u);
            if (lv_unit == null) { break; }
            libNtve_gf_PauseUnit(lv_unit, true);
        }
    }
    else if ((lv_verb == "boss")) {
${boss_line}    }
    else if ((lv_verb == "terrain")) {
${terrain_line}    }
    else if ((lv_verb == "holes")) {
        hrsCap_holesShown = (StringWord(hrsCap_cmd, 3) == "show");
        if ((hrsCap_holes != null)) {
            TerrainShowRegion(hrsCap_holes, hrsCap_holesShown);
        }
    }
    else if ((lv_verb == "isolate")) {
        hrsCap_Isolate((StringWord(hrsCap_cmd, 3) == "on"), StringToFixed(StringWord(hrsCap_cmd, 4)), StringToFixed(StringWord(hrsCap_cmd, 5)), StringToFixed(StringWord(hrsCap_cmd, 6)));
    }
    else if ((lv_verb == "env")) {
        // The whole scene but the units on show, for the elements capture: every unit in sight
        // but the structures hidden with the terrain (as "isolate", with no circle kept), and the environment's
        // terrain, doodads and water switched off. EnvironmentShow isn't in Blizzard's scripts but
        // is in the game's table of script functions, next to TerrainShowRegion; switching the
        // terrain off as a whole should take the cliff doodads too (terrain objects the terrain
        // draws itself, which neither TerrainShowRegion nor actor messages reach).
        if ((StringWord(hrsCap_cmd, 3) == "off")) {
            hrsCap_isolateStructures = false;  // the structures stay: faded out ("el fadeall 0")
            hrsCap_Isolate(true, 0.0, 0.0, 0.0);
            EnvironmentShow(c_environmentTerrain, false);
            EnvironmentShow(c_environmentDoodads, false);
            EnvironmentShow(c_environmentWater, false);
        }
        else {
            EnvironmentShow(c_environmentTerrain, true);
            EnvironmentShow(c_environmentDoodads, true);
            EnvironmentShow(c_environmentWater, true);
            hrsCap_Isolate(false, 0.0, 0.0, 0.0);
            hrsCap_isolateStructures = true;
        }
    }
    else if ((lv_verb == "smsg")) {
        hrsCap_StructuresMessage(hrsCap_CommandWords(3));
    }
    else if ((lv_verb == "umsg")) {
        lv_unit = hrsCap_StructureAt(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4)));
        if ((lv_unit != null)) {
            ActorSend(libNtve_gf_MainActorofUnit(lv_unit), hrsCap_CommandWords(5));
        }
    }
    else if ((lv_verb == "msg")) {
        libNtve_gf_SendActorMessageToGameRegion(${map_region}, hrsCap_CommandWords(3));
    }
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    hrsCap_Ack();
    return true;
}

// "quit" ends the match by killing that player's own core: the game then ends it its normal way
// (end sequence, defeat), back towards the menu, where the next run's map loads. (Ending it
// directly with GameOver crashed Battlefield of Eternity once the match had run about 30 s.) On
// a map of rounds the other team is first one round win short of the match, so this round is
// the last.
bool hrsCap_gt_Quit_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    hrsCap_leaving = true;
    hrsCap_StatusDraw();  // the strip says "leaving" at once (Restore shows the interface again)
    Wait(0.25, c_timeReal);
    hrsCap_Restore();
    Wait(0.5, c_timeReal);
${arena_quit_line}    UnitKill(libGame_gv_teams[libGame_gf_TeamNumberOfPlayer(hrsCap_cmdPlayer)].lv_core);
    return true;
}

void hrsCap_Init () {
    hrsCap_HolesInit();
    hrsCap_QuietFalls();
    hrsCap_SaveFrames();
    hrsCap_InitTiles();
    hrsCap_StatusInit();
    hrsCap_NoteInit();
    // The commands' triggers, run by hrsCap_RunCommand (the first word of what was typed into the
    // command box picks one).
    hrsCap_gt_Clean = TriggerCreate("hrsCap_gt_Clean_Func");
    hrsCap_gt_Move = TriggerCreate("hrsCap_gt_Move_Func");
    hrsCap_gt_Tile = TriggerCreate("hrsCap_gt_Tile_Func");
    hrsCap_gt_Pause = TriggerCreate("hrsCap_gt_Pause_Func");
    hrsCap_gt_Sky = TriggerCreate("hrsCap_gt_Sky_Func");
    hrsCap_gt_Black = TriggerCreate("hrsCap_gt_Black_Func");
    hrsCap_gt_Clip = TriggerCreate("hrsCap_gt_Clip_Func");
    hrsCap_gt_Fov = TriggerCreate("hrsCap_gt_Fov_Func");
    hrsCap_gt_HideMap = TriggerCreate("hrsCap_gt_HideMap_Func");
    hrsCap_gt_RefitWait = TriggerCreate("hrsCap_gt_RefitWait_Func");
    hrsCap_gt_Unbound = TriggerCreate("hrsCap_gt_Unbound_Func");
    hrsCap_gt_BgSpeed = TriggerCreate("hrsCap_gt_BgSpeed_Func");
    hrsCap_gt_Look = TriggerCreate("hrsCap_gt_Look_Func");
    hrsCap_gt_Quit = TriggerCreate("hrsCap_gt_Quit_Func");
    hrsCap_gt_Element = TriggerCreate("hrsCap_gt_Element_Func");
    hrsCap_gt_Note = TriggerCreate("hrsCap_gt_Note_Func");
    hrsCap_gt_FastForward = TriggerCreate("hrsCap_gt_FastForward_Func");
    libCore_gv_bALOpenTheGatesDelay = hrsCap_gatesDelay;  // read when GameLib starts its countdown
    hrsCap_gt_Sweep = TriggerCreate("hrsCap_gt_Sweep_Func");
    TriggerAddEventTimePeriodic(hrsCap_gt_Sweep, 0.25, c_timeReal);
    hrsCap_gt_Quiet = TriggerCreate("hrsCap_gt_Quiet_Func");
    TriggerAddEventTimePeriodic(hrsCap_gt_Quiet, 0.0625, c_timeReal);
    hrsCap_BoxInit();
}

