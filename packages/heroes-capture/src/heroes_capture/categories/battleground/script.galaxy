//--------------------------------------------------------------------------------------------------
// The battlegrounds' part: their structures and camps, one at a time ("el ..."), brought down, and
// the holes their cores stand on.
//--------------------------------------------------------------------------------------------------
// init: hrsCap_BattlegroundInit
// command: el hrsCap_gt_Element_Func

unit[128] hrsCap_copies;  // the elements' copies of structures ("el copy"), by number

// The elements capture (ELEMENTS-PLAN.md): the map's structures and camps one at a time. The
// structure nearest a cell (within 3 cells), never a copy ("el copy": one may stand on its
// structure's own cell), or null.
unit hrsCap_StructureAt (fixed lp_x, fixed lp_y) {
    unitgroup lv_g;
    int lv_i;

    lv_g = UnitGroup(null, c_playerAny, RegionCircle(Point(lp_x, lp_y), 3.0), UnitFilter((1 << c_targetFilterStructure), 0, 0, 0), 0);
    lv_i = 0;
    for ( ; lv_i < 128 ; lv_i += 1 ) {
        if ((hrsCap_copies[lv_i] != null)) {
            UnitGroupRemove(lv_g, hrsCap_copies[lv_i]);
        }
    }
    return UnitGroupClosestToPoint(lv_g, Point(lp_x, lp_y));
}

// Fades from word lp_from of the command on, three words each, "<x> <y> <opacity>" (the sequence
// number after them never part of one): the structure nearest each cell faded to that opacity at
// once, every actor of its own (an actor scope's "SetOpacity <opacity> 0"). Several in one
// command, for the elements capture's round trips.
void hrsCap_FadeTriples (int lp_from) {
    int lv_w;
    unit lv_unit;

    lv_w = lp_from;
    while ((StringWord(hrsCap_cmd, (lv_w + 3)) != "")) {
        lv_unit = hrsCap_StructureAt(StringToFixed(StringWord(hrsCap_cmd, lv_w)), StringToFixed(StringWord(hrsCap_cmd, (lv_w + 1))));
        if ((lv_unit != null)) {
            ActorScopeSend(ActorScopeFromUnit(lv_unit), ("SetOpacity " + StringWord(hrsCap_cmd, (lv_w + 2)) + " 0"));
        }
        lv_w += 3;
    }
}

// A structure shown or hidden (hidden: the unit's hidden state, so it can be shown again), and
// every actor of its own with it: a core's orbiting shield crystals and its shield's aura are
// actors of its own that hiding the unit leaves.
void hrsCap_ShowStructure (unit lp_unit, bool lp_show) {
    libNtve_gf_ShowHideUnit(lp_unit, lp_show);
    if (lp_show) {
        ActorScopeSend(ActorScopeFromUnit(lp_unit), "SetVisibility 1");
    }
    else {
        ActorScopeSend(ActorScopeFromUnit(lp_unit), "SetVisibility 0");
    }
}

// Every structure shown or hidden (hrsCap_ShowStructure).
void hrsCap_ShowAllStructures (bool lp_show) {
    unitgroup lv_g;
    int lv_u;
    unit lv_unit;

    lv_g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, 0, 0), 0);
    lv_u = UnitGroupCount(lv_g, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_g, lv_u);
        if (lv_unit == null) { break; }
        hrsCap_ShowStructure(lv_unit, lp_show);
    }
}

// Every standing structure but the copies faded out or in, its own actors with it ("el fadeall":
// the elements capture's standing shots). Its opacity, not its visibility: hidden and shown again
// while paused, a structure gives off no particles until it plays, but faded out and in it comes
// back exactly as it was (probed: effects, a core's shield crystals and all).
void hrsCap_FadeAllStructures (bool lp_in) {
    unitgroup lv_g;
    int lv_u;
    unit lv_unit;

    lv_g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    lv_u = 0;
    for ( ; lv_u < 128 ; lv_u += 1 ) {
        if ((hrsCap_copies[lv_u] != null)) {
            UnitGroupRemove(lv_g, hrsCap_copies[lv_u]);
        }
    }
    lv_u = UnitGroupCount(lv_g, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_g, lv_u);
        if (lv_unit == null) { break; }
        UnitSetState(lv_unit, c_unitStateHighlightable, false);  // never outlined under the mouse
        if (lp_in) {
            ActorScopeSend(ActorScopeFromUnit(lv_unit), "SetOpacity 1 0");
        }
        else {
            ActorScopeSend(ActorScopeFromUnit(lv_unit), "SetOpacity 0 0");
        }
    }
}

// Structures brought down without what a fall sets off for the players: GameLib plants a loot
// banner (its waving flag, a red glow) in a fallen town hall's rubble while this is on (set again
// before every fall, in case GameLib sets it), and gives XP (with its floating text) while its XP
// switch is on and the unit hasn't UnitGivesNoXP (given to each structure before it falls).
void hrsCap_QuietFalls () {
    libGame_gv_loot_DropBannerInTownHallRubble = false;
    libCore_gv_sYSXPOn = false;  // GameLib's XP switch: no XP, and none of its floating text, from any kill
    // A fallen fort's or keep's "PERIODIC/CONSTANT CATAPULTS & XP" text (GameLib's
    // libGame_gt_TownStructureDies shows it unless the map never spawns catapults).
    libGame_gv_minionMapNeverSpawnsCatapults = true;
}

// A structure brought down where it can be seen: shown, its animations running for its death. A
// tower doesn't die: as the game does when one falls, it gets TownCannonTowerInvulnerable and
// morphs into TownCannonTowerDead, its rubble (the AI library orders that morph; ordered here too).
// Anything else is killed.
void hrsCap_Kill (unit lp_unit) {
    hrsCap_QuietFalls();
    UnitBehaviorAdd(lp_unit, "UnitGivesNoXP", lp_unit, 1);
    // Shown with its own actors (hidden with them by "el hideall"): shown as a unit only, its
    // actors stayed invisible, and so did all its rubble.
    hrsCap_ShowStructure(lp_unit, true);
    libNtve_gf_SendActorMessageToUnit(lp_unit, "AnimSetPausedAll 0");
    // By the ability, not the Tower attribute: town halls have the attribute too (they shoot), but
    // no TowerDeadMorph, and ordered it they never fell.
    if (UnitAbilityExists(lp_unit, "TowerDeadMorph")) {
        UnitBehaviorAdd(lp_unit, "TownCannonTowerInvulnerable", lp_unit, 1);
        UnitIssueOrder(lp_unit, Order(AbilityCommand("TowerDeadMorph", 0)), c_orderQueueReplace);
    }
    else {
        UnitKill(lp_unit);
    }
}

// One structure brought down, then, after lp_wait real seconds, the map's animations paused again
// (its rubble with them); a wait below 0: not paused (the elements capture brings a wave down,
// waits once and pauses with "el freeze").
void hrsCap_KillShown (unit lp_unit, fixed lp_wait) {
    hrsCap_Kill(lp_unit);
    if ((lp_wait < 0.0)) {
        return;
    }
    Wait(lp_wait, c_timeReal);
    libNtve_gf_SendActorMessageToGameRegion(${map_region}, "AnimSetPausedAll");
}

// Every structure brought down but the two teams' cores (by then the hidden replacements "el core"
// put in their place, which nothing may kill: the match would end), then the animations paused
// again after lp_wait real seconds.
void hrsCap_KillAll (fixed lp_wait) {
    unitgroup lv_g;
    int lv_u;
    unit lv_unit;

    lv_g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    lv_u = UnitGroupCount(lv_g, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_g, lv_u);
        if (lv_unit == null) { break; }
        if ((lv_unit != libGame_gv_teams[libGame_gv_teamOrderIndex_C].lv_core) && (lv_unit != libGame_gv_teams[libGame_gv_teamChaosIndex_C].lv_core)) {
            hrsCap_Kill(lv_unit);
        }
    }
    Wait(lp_wait, c_timeReal);
    libNtve_gf_SendActorMessageToGameRegion(${map_region}, "AnimSetPausedAll");
}

// The holes in the terrain the cores stand on: filled in the map file (specifics.py), opened here over
// exactly their cells as the script starts, so the map looks as the game draws it (the sky through
// a core's centre); shown on "el holes show" (the ground where a core stood, once it's gone).
region hrsCap_holes;
bool hrsCap_holesShown = false;

void hrsCap_HolesInit () {
    if (!${has_holes}) {
        return;
    }
    hrsCap_holes = RegionEmpty();${hole_lines}
    TerrainShowRegion(hrsCap_holes, false);
}

// The holes as they should be now, after anything that showed all the terrain: open, unless "el
// holes show" showed them.
void hrsCap_OpenHoles () {
    if ((hrsCap_holes != null) && !hrsCap_holesShown) {
        TerrainShowRegion(hrsCap_holes, false);
    }
}

// "el isolate": every unit in sight outside a circle round what is on show hidden, and kept here
// to be shown again (units already hidden, as the structures "el hideall" hid, aren't touched);
// and the loot banners outside it too (a banner is a model of its own, which hiding its stand
// leaves), shown again with it. Only the banners: an actor-region message reaches every actor whose
// bounds touch the region, and a fallen structure's rubble (a model, its bounds wide) at the
// circle's middle would go with them.
unitgroup hrsCap_isolatedUnits;
// Whether isolating hides the elements' structures too ("el env off" leaves them, every other
// structure hidden: the elements capture fades them by opacity instead, since hiding one and
// showing it again restarts its animations, a level 3 tower's into its birth, and loses its
// particles).
bool hrsCap_isolateStructures = true;

// One of the elements' structures (elements.is_structure: a town's, Town..., or a core, ...Core);
// the map's other structures (hidden figures it keeps) are hidden with the rest by "el env off".
bool hrsCap_IsElementStructure (unit lp_unit) {
    string lv_type;

    lv_type = UnitGetType(lp_unit);
    if ((StringSub(lv_type, 1, 4) == "Town")) {
        return true;
    }
    return (StringLength(lv_type) >= 4) && (StringSub(lv_type, StringLength(lv_type) - 3, StringLength(lv_type)) == "Core");
}
region hrsCap_isolatedArea;

// An actor message to every loot banner in a region (the actors in a LootBanner's scope).
void hrsCap_BannersMessage (region lp_area, string lp_message) {
    actor lv_region;

    ActorRegionCreate(null, "TriggerRegion", lp_area);
    lv_region = libNtve_gf_ActorLastCreated();
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, lp_message, "Model", "ScopeContains LootBanner");
    ActorScopeKill(ActorScopeFromActor(lv_region));
}

void hrsCap_IsolateUnits (fixed lp_x, fixed lp_y, fixed lp_radius) {
    region lv_outside;
    int lv_u;
    unit lv_unit;

    lv_outside = ${map_region};
    RegionAddCircle(lv_outside, false, Point(lp_x, lp_y), lp_radius);
    hrsCap_isolatedArea = lv_outside;
    hrsCap_BannersMessage(lv_outside, "SetVisibility 0");
    hrsCap_isolatedUnits = UnitGroup(null, c_playerAny, lv_outside, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_u = UnitGroupCount(hrsCap_isolatedUnits, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(hrsCap_isolatedUnits, lv_u);
        if (lv_unit == null) { break; }
        if (!hrsCap_isolateStructures && hrsCap_IsElementStructure(lv_unit)) {
            UnitGroupRemove(hrsCap_isolatedUnits, lv_unit);
        }
        else {
            libNtve_gf_ShowHideUnit(lv_unit, false);
        }
    }
}

void hrsCap_RestoreUnits () {
    int lv_u;
    unit lv_unit;

    if ((hrsCap_isolatedUnits == null)) {
        return;
    }
    lv_u = UnitGroupCount(hrsCap_isolatedUnits, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(hrsCap_isolatedUnits, lv_u);
        if (lv_unit == null) { break; }
        libNtve_gf_ShowHideUnit(lv_unit, true);
    }
    hrsCap_isolatedUnits = null;
    if ((hrsCap_isolatedArea != null)) {
        hrsCap_BannersMessage(hrsCap_isolatedArea, "SetVisibility 1");
        hrsCap_isolatedArea = null;
    }
}

// Every fallen structure's remains taken away, as Blizzard's own maps clear a destroyed town (the
// tutorial's town reset, libNtve_gf_RemoveDeathModelsinRegion): the towers' rubble units removed,
// the death models destroyed (aliases _DeathModel; the gates' _Clearable; _DeadClearable), and
// the debris and smoke particles still in the world. A structure's ground patch goes with it
// (the patch stays under a structure that is only hidden).
void hrsCap_ClearRemains () {
    unitgroup lv_g;
    int lv_u;
    unit lv_unit;
    actor lv_region;

    lv_g = UnitGroup("TownCannonTowerDead", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
    lv_u = UnitGroupCount(lv_g, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_g, lv_u);
        if (lv_unit == null) { break; }
        UnitRemove(lv_unit);
    }
    ActorRegionCreate(null, "TriggerRegion", ${map_region});
    lv_region = libNtve_gf_ActorLastCreated();
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, "Destroy", "Model", "ScopeContains _DeathModel");
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, "Destroy", "Unit", "ScopeContains _DeathModel");
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, "Destroy", "Model", "ScopeContains _Clearable");
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, "Destroy", "Unit", "ScopeContains _Clearable");
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, "Destroy", "Model", "ScopeContains _DeadClearable");
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, "Destroy", "Unit", "ScopeContains _DeadClearable");
    ActorWorldParticleFXDestroy();
    ActorScopeKill(ActorScopeFromActor(lv_region));
}

// Every fallen town structure's own actor destroyed: a town hall's stays after its death (its
// actor prepares its death sequence with PreventKill) and goes on drawing its dark patch on the
// ground. Blizzard's town actors destroy themselves on this signal (TownBaseStructure's
// "Signal.*.ClearTownStructureDeathModel"); a standing structure's would too, so "el clear all" is
// for once every structure but the replacement cores (not town actors) is down.
void hrsCap_ClearFallenActors () {
    actor lv_region;

    ActorRegionCreate(null, "TriggerRegion", ${map_region});
    lv_region = libNtve_gf_ActorLastCreated();
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, "Signal ClearTownStructureDeathModel", "Unit", "");
    ActorScopeKill(ActorScopeFromActor(lv_region));
}

// The pausing probe's messages (calibrate.py's pausing), each sent to every actor in the map's
// region (by radius contact and by centre) and to every unit's actor scope ("el pausemsg").
void hrsCap_PauseSend (string lp_message) {
    actor lv_region;
    unitgroup lv_g;
    int lv_u;
    unit lv_unit;

    ActorRegionCreate(null, "TriggerRegion", ${map_region});
    lv_region = libNtve_gf_ActorLastCreated();
    ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, lp_message, null, null);
    ActorRegionSend(lv_region, c_actorIntersectAgainstCenter, lp_message, null, null);
    ActorSend(lv_region, "Destroy");
    lv_g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    lv_u = UnitGroupCount(lv_g, c_unitCountAll);
    for (;; lv_u -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_g, lv_u);
        if (lv_unit == null) { break; }
        ActorScopeSend(ActorScopeFromUnit(lv_unit), lp_message);
    }
}

${isolate_function}
// "el <verb> ...", the map's elements (ELEMENTS-PLAN.md; the elements capture):
// "at <x> <y> [<x> <y> <opacity> ...]" (the camera straight above the cell, its lighting refitted,
// without the rest of "tile"'s scene; any structures after it faded first, up to four);
// "fades <x> <y> <opacity> ..." (each structure nearest a cell faded, up to four in one command);
// "fadeall 0|1" (every standing structure but the copies faded out or in: hidden without losing
// its effects); "hideall" (every structure hidden, its actors with it);
// "kill <x> <y> <seconds>" (brought down, its rubble left; seconds below 0: not paused after);
// "killall <seconds>" (every structure but the two cores); "core <team> <seconds>" (the team's
// core killed after a hidden replacement takes its place as the team's core, so nothing ends the
// match: everything that would listens for the death of whatever that variable holds; the
// replacement has no model); "clear" (every fallen structure's remains taken away; "clear all":
// and the fallen town structures' own actors, once every structure is down);
// "keep 1|0" (the sweep leaves camps alone); "camp <n>" (0: every camp) spawned as its respawn
// timer would; "freeze" (animations paused again and units paused: what spawned since); "play"
// (every animation let run again, units left paused: what was shown while paused gives off no
// particles until it plays);
// "copy <n> make <x> <y> <to x> <to y>" (copy n of the structure nearest the cell, the same type,
// owner and facing, standing at the other cell), "copy <n> kill|show|hide|play|remove|msg <message>" (by
// number, as a copy on its structure's own cell can't be told from it by place; remove: gone, no
// rubble, the calibration's tries; msg: an actor message, "~" for its spaces, to the copy's scope); "copykill <from> <to>" (copies
// from..to brought down at once: the rubble, prepared on spare spots while the structures stand);
// "pausemsg <message>" (an actor message, "~" for its spaces, to every actor and unit scope on the
// map: the pausing probe); "typemsg <unit type> <message>" (the same to every unit of a type's
// actor scope); "restart <x> <y> <model>" (the structure nearest the cell swapped to its finished
// model and let run: its animations from the start) and "hold <x> <y>" (paused again: the standing
// timing);
// "farclip <distance>" (the camera's far clip plane moved); "worldfx" (the particles
// left in the world destroyed); "light <x> <y> <seconds>" (the
// structure nearest the cell let run that long and paused again: its effects lit by the camera); "clock <scale>" (the game's
// clock scaled: GameSetGlobalTimeScale, in the game's table of script functions); "water on|off" (the water alone, which no pause stills,
// hidden or shown again);
// "wide <x> <y> <distance>" (the camera far back straight above the cell: a fall gives off its
// particles only near the camera); "holes show|hide" (the holes the cores stand on, filled in the
// map file: the ground where a core stood, or open as the game draws them); "env off|on" (every
// unit in sight but the structures hidden with the terrain, doodads and water: the whole scene but
// what is shown, or all back); "paint <x> <y> <radius> <msg~>" (an actor message, "~" for its
// spaces, to every model and unit actor round the cell: a structure's remains repainted in the other
// side's team colour, "SetTeamColor", and back, "ClearTeamColor"). (Our player's side: the capture's
// "side".)
bool hrsCap_gt_Element_Func (bool testConds, bool runActions) {
    string lv_verb;
    actor lv_region;
    unit lv_unit;
    unit lv_core;
    unitgroup lv_g;
    int lv_u;
    int lv_n;
    int lv_team;

    if (!runActions) {
        return true;
    }
    lv_verb = StringWord(hrsCap_cmd, 2);
    if ((lv_verb == "hideall")) {
        hrsCap_ShowAllStructures(false);
    }
    else if ((lv_verb == "kill")) {
        lv_unit = hrsCap_StructureAt(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4)));
        if ((lv_unit != null)) {
            hrsCap_KillShown(lv_unit, StringToFixed(StringWord(hrsCap_cmd, 5)));
        }
    }
    else if ((lv_verb == "core")) {
        lv_team = StringToInt(StringWord(hrsCap_cmd, 3));
        lv_core = libGame_gv_teams[lv_team].lv_core;
        UnitCreate(1, UnitGetType(lv_core), c_unitCreateIgnorePlacement, UnitGetOwner(lv_core), UnitGetPosition(lv_core), UnitGetFacing(lv_core), null);
        libNtve_gf_ShowHideUnit(UnitLastCreated(), false);
        // No model at all: a structure hidden after being shown ("el showall") leaves the dark patch
        // its model draws on the ground; with no model, nothing of it is ever drawn.
        ActorSend(libNtve_gf_MainActorofUnit(UnitLastCreated()), "ModelSwap Invisible");
        libGame_gv_teams[lv_team].lv_core = UnitLastCreated();
        hrsCap_KillShown(lv_core, StringToFixed(StringWord(hrsCap_cmd, 4)));
    }
    else if ((lv_verb == "at")) {
        hrsCap_NoteHide();  // a shot starts here: no note in it
        // The camera straight above a cell, as "tile" puts it but without the rest of its scene (the
        // reveal and the hidden interface hold from the last tile): the lighting refitted there
        // first (without it, structures away from the last refit came out duller: the keeps' glows
        // half gone), then the capture camera (pitch, distance, lens and clip planes: a sky shot's
        // "hidemap" pushes the near clip past the ground), the light sky put back. For the
        // elements, shot with the scene hidden. Any "<x> <y> <opacity>" after the cell: those
        // structures faded first (hrsCap_FadeTriples).
        hrsCap_FadeTriples(5);
        CameraPan(hrsCap_cmdPlayer, Point(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4))), 0.0, -1, 10.0, false);
        hrsCap_NormalCamera(hrsCap_cmdPlayer);
        Wait(hrsCap_refitWait, c_timeReal);
        hrsCap_ApplyCamera(hrsCap_cmdPlayer);
        CameraPan(hrsCap_cmdPlayer, Point(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4))), 0.0, -1, 10.0, false);
        hrsCap_statusPlayer = hrsCap_cmdPlayer;
        hrsCap_WaitCameraStill();
        GameSetBackground(0, "${light_sky_model}", 100.0);
        hrsCap_skyState = 1;
        TransmissionClearGroup(PlayerGroupAll());
    }
    else if ((lv_verb == "fades")) {
        // Several structures faded at once, "<x> <y> <opacity>" each (hrsCap_FadeTriples).
        hrsCap_FadeTriples(3);
    }
    else if ((lv_verb == "killall")) {
        hrsCap_KillAll(StringToFixed(StringWord(hrsCap_cmd, 3)));
    }
    else if ((lv_verb == "clear")) {
        hrsCap_ClearRemains();
        if ((StringWord(hrsCap_cmd, 3) == "all")) {
            hrsCap_ClearFallenActors();
        }
    }
    else if ((lv_verb == "keep")) {
        hrsCap_keepCreeps = (StringWord(hrsCap_cmd, 3) == "1");
    }
    else if ((lv_verb == "camp")) {
        lv_n = StringToInt(StringWord(hrsCap_cmd, 3));
        if ((lv_n > 0)) {
            libMapM_gf_JungleRespawnCreepsForCamp(lv_n);
        }
        else {
            lv_n = 1;
            for ( ; lv_n <= libMapM_gv_jungleNumberOfCreepCamps ; lv_n += 1 ) {
                libMapM_gf_JungleRespawnCreepsForCamp(lv_n);
            }
        }
    }
    else if ((lv_verb == "copy")) {
        lv_n = StringToInt(StringWord(hrsCap_cmd, 3));
        if ((StringWord(hrsCap_cmd, 4) == "make")) {
            lv_unit = hrsCap_StructureAt(StringToFixed(StringWord(hrsCap_cmd, 5)), StringToFixed(StringWord(hrsCap_cmd, 6)));
            if ((lv_unit != null)) {
                UnitCreate(1, UnitGetType(lv_unit), c_unitCreateIgnorePlacement, UnitGetOwner(lv_unit),
                           Point(StringToFixed(StringWord(hrsCap_cmd, 7)), StringToFixed(StringWord(hrsCap_cmd, 8))), UnitGetFacing(lv_unit), null);
                hrsCap_copies[lv_n] = UnitLastCreated();
                UnitSetState(hrsCap_copies[lv_n], c_unitStateHighlightable, false);
            }
        }
        else if ((hrsCap_copies[lv_n] != null)) {
            if ((StringWord(hrsCap_cmd, 4) == "kill")) {
                hrsCap_Kill(hrsCap_copies[lv_n]);
            }
            else if ((StringWord(hrsCap_cmd, 4) == "play")) {
                ActorScopeSend(ActorScopeFromUnit(hrsCap_copies[lv_n]), "AnimSetPausedAll 0");
            }
            else if ((StringWord(hrsCap_cmd, 4) == "remove")) {
                UnitRemove(hrsCap_copies[lv_n]);
                hrsCap_copies[lv_n] = null;
            }
            else if ((StringWord(hrsCap_cmd, 4) == "msg")) {
                // An actor message ("~" for its spaces) to the copy's actor scope.
                ActorScopeSend(ActorScopeFromUnit(hrsCap_copies[lv_n]), StringReplaceWord(StringWord(hrsCap_cmd, 5), "~", " ", c_stringReplaceAll, c_stringCase));
            }
            else {
                hrsCap_ShowStructure(hrsCap_copies[lv_n], (StringWord(hrsCap_cmd, 4) == "show"));
            }
        }
    }
    else if ((lv_verb == "wide")) {
        // The camera far back straight above a cell (a structure falling far from the camera gives
        // off none of its particles). "at" puts the capture camera back.
        CameraPan(hrsCap_cmdPlayer, Point(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4))), 0.0, -1, 10.0, false);
        CameraSetValue(hrsCap_cmdPlayer, c_cameraValueDistance, StringToFixed(StringWord(hrsCap_cmd, 5)), 0.0, -1, 10.0);
        CameraSetValue(hrsCap_cmdPlayer, c_cameraValueFarClip, (StringToFixed(StringWord(hrsCap_cmd, 5)) * 2.0), 0.0, -1, 10.0);
        hrsCap_statusPlayer = hrsCap_cmdPlayer;
        hrsCap_WaitCameraStill();
    }
    else if ((lv_verb == "msg")) {
        // "el msg <x> <y> <message>": an actor message ("~" for its spaces) to the structure there
        // (its model variation set before it falls: the variation picks a gate's or a wall's remains).
        lv_unit = hrsCap_StructureAt(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4)));
        if ((lv_unit != null)) {
            ActorScopeSend(ActorScopeFromUnit(lv_unit), StringReplaceWord(StringWord(hrsCap_cmd, 5), "~", " ", c_stringReplaceAll, c_stringCase));
        }
    }
    else if ((lv_verb == "pausemsg")) {
        // The message with "~" for its spaces (the command's words are split at spaces).
        hrsCap_PauseSend(StringReplaceWord(StringWord(hrsCap_cmd, 3), "~", " ", c_stringReplaceAll, c_stringCase));
    }
    else if ((lv_verb == "clock")) {
        GameSetGlobalTimeScale(StringToFixed(StringWord(hrsCap_cmd, 3)));
    }
    else if ((lv_verb == "paint")) {
        ActorRegionCreate(null, "TriggerRegion", RegionCircle(Point(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4))), StringToFixed(StringWord(hrsCap_cmd, 5))));
        lv_region = libNtve_gf_ActorLastCreated();
        ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, StringReplaceWord(StringWord(hrsCap_cmd, 6), "~", " ", c_stringReplaceAll, c_stringCase), "Model", "");
        ActorRegionSend(lv_region, c_actorIntersectAgainstRadiusContact, StringReplaceWord(StringWord(hrsCap_cmd, 6), "~", " ", c_stringReplaceAll, c_stringCase), "Unit", "");
        ActorScopeKill(ActorScopeFromActor(lv_region));
    }
    else if ((lv_verb == "typemsg")) {
        // An actor message ("~" for its spaces) to every unit of one type's actor scope.
        lv_g = UnitGroup(StringWord(hrsCap_cmd, 3), c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
        lv_u = UnitGroupCount(lv_g, c_unitCountAll);
        for (;; lv_u -= 1) {
            lv_unit = UnitGroupUnitFromEnd(lv_g, lv_u);
            if (lv_unit == null) { break; }
            ActorScopeSend(ActorScopeFromUnit(lv_unit), StringReplaceWord(StringWord(hrsCap_cmd, 4), "~", " ", c_stringReplaceAll, c_stringCase));
        }
    }
    else if ((lv_verb == "farclip")) {
        // The camera's far clip plane moved (the stacking probe cuts what is sunk below the ground).
        CameraSetValue(hrsCap_cmdPlayer, c_cameraValueFarClip, StringToFixed(StringWord(hrsCap_cmd, 3)), 0.0, -1, 10.0);
    }
    else if ((lv_verb == "worldfx")) {
        ActorWorldParticleFXDestroy();
    }
    else if ((lv_verb == "restart")) {
        // "el restart <x> <y> [<model>|-] [<seconds>]": one structure swapped to its finished model
        // (the model it shows once built: swapping to a model starts its animations from the start,
        // and Blizzard's structure template restarts its global loops on every swap; "-" or none:
        // no swap) and let run: the standing timing's fixed start. With seconds, paused again that
        // many real seconds later, before the answer: the restart and the pause in one command.
        lv_unit = hrsCap_StructureAt(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4)));
        if ((lv_unit != null)) {
            if ((StringWord(hrsCap_cmd, 5) != "") && (StringWord(hrsCap_cmd, 5) != "-")) {
                ActorScopeSend(ActorScopeFromUnit(lv_unit), ("ModelSwap " + StringWord(hrsCap_cmd, 5)));
            }
            ActorScopeSend(ActorScopeFromUnit(lv_unit), "AnimSetPausedAll 0");
            if ((StringWord(hrsCap_cmd, 6) != "")) {
                Wait(StringToFixed(StringWord(hrsCap_cmd, 6)), c_timeReal);
                ActorScopeSend(ActorScopeFromUnit(lv_unit), "AnimSetPausedAll");
            }
        }
    }
    else if ((lv_verb == "hold")) {
        // One structure's animations paused again.
        lv_unit = hrsCap_StructureAt(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4)));
        if ((lv_unit != null)) {
            ActorScopeSend(ActorScopeFromUnit(lv_unit), "AnimSetPausedAll");
        }
    }
    else if ((lv_verb == "light")) {
        // One structure's effects lit: its animations let run for the seconds given, with the camera
        // over it (a model's particles only run near the camera), then paused again.
        lv_unit = hrsCap_StructureAt(StringToFixed(StringWord(hrsCap_cmd, 3)), StringToFixed(StringWord(hrsCap_cmd, 4)));
        if ((lv_unit != null)) {
            ActorScopeSend(ActorScopeFromUnit(lv_unit), "AnimSetPausedAll 0");
            Wait(StringToFixed(StringWord(hrsCap_cmd, 5)), c_timeReal);
            ActorScopeSend(ActorScopeFromUnit(lv_unit), "AnimSetPausedAll");
        }
    }
    else if ((lv_verb == "water")) {
        EnvironmentShow(c_environmentWater, (StringWord(hrsCap_cmd, 3) == "on"));
    }
    else if ((lv_verb == "fadeall")) {
        hrsCap_FadeAllStructures((StringWord(hrsCap_cmd, 3) == "1"));
    }
    else if ((lv_verb == "copykill")) {
        lv_n = StringToInt(StringWord(hrsCap_cmd, 3));
        for ( ; lv_n <= StringToInt(StringWord(hrsCap_cmd, 4)) ; lv_n += 1 ) {
            if ((hrsCap_copies[lv_n] != null)) {
                hrsCap_Kill(hrsCap_copies[lv_n]);
            }
        }
    }
    else if ((lv_verb == "play")) {
        libNtve_gf_SendActorMessageToGameRegion(${map_region}, "AnimSetPausedAll 0");
    }
    else if ((lv_verb == "freeze")) {
        libNtve_gf_SendActorMessageToGameRegion(${map_region}, "AnimSetPausedAll");
        lv_g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, ((1 << c_targetFilterStructure) | (1 << c_targetFilterMissile)), 0), 0);
        lv_u = UnitGroupCount(lv_g, c_unitCountAll);
        for (;; lv_u -= 1) {
            lv_unit = UnitGroupUnitFromEnd(lv_g, lv_u);
            if (lv_unit == null) { break; }
            libNtve_gf_PauseUnit(lv_unit, true);
        }
    }
    else if ((lv_verb == "holes")) {
        hrsCap_holesShown = (StringWord(hrsCap_cmd, 3) == "show");
        if ((hrsCap_holes != null)) {
            TerrainShowRegion(hrsCap_holes, hrsCap_holesShown);
        }
    }
    else if ((lv_verb == "env")) {
        // The whole scene but the units on show, for the elements capture: every unit in sight
        // but the structures hidden with the terrain (as "isolate", with no circle kept), and the environment's
        // terrain, doodads and water switched off. EnvironmentShow isn't in Blizzard's scripts but
        // is in the game's table of script functions, next to TerrainShowRegion; switching the
        // terrain off as a whole should take the cliff doodads too (terrain objects the terrain
        // draws itself, which neither TerrainShowRegion nor actor messages reach).
        if ((StringWord(hrsCap_cmd, 3) == "off")) {
            hrsCap_isolateStructures = false;  // the structures stay: faded out ("el fadeall 0")
            hrsCap_Isolate(true, 0.0, 0.0, 0.0);
            EnvironmentShow(c_environmentTerrain, false);
            EnvironmentShow(c_environmentDoodads, false);
            EnvironmentShow(c_environmentWater, false);
        }
        else {
            EnvironmentShow(c_environmentTerrain, true);
            EnvironmentShow(c_environmentDoodads, true);
            EnvironmentShow(c_environmentWater, true);
            hrsCap_Isolate(false, 0.0, 0.0, 0.0);
            hrsCap_isolateStructures = true;
        }
    }
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    hrsCap_Ack();
    return true;
}

void hrsCap_BattlegroundInit () {
    hrsCap_HolesInit();
    hrsCap_QuietFalls();
}
